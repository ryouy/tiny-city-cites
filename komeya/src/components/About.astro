---
import { stories, site } from '../data/site';
import Photo from './Photo.astro';
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container">
  <div class="about__grid">
    <div class="about__text">
      <h2 id="about-title" class="h2">{stories.about.heading}</h2>
      <p>{stories.about.body}</p>
    </div>
    <div class="about__photos">
      <Photo name="rice" ratio="4 / 3" sizes="(min-width: 900px) 520px, 100vw" />
      <Photo name="interior" ratio="4 / 3" sizes="(min-width: 900px) 440px, 100vw" />
    </div>
  </div>
  <dl class="stats">
    <div><dt>開業</dt><dd><b>1998</b>年4月</dd></div>
    <div><dt>席数</dt><dd><b>{site.seats.total}</b>席</dd></div>
    <div><dt>駐車場</dt><dd><b>{parseInt(site.parking, 10)}</b>台</dd></div>
  </dl>
  </div>
</section>
