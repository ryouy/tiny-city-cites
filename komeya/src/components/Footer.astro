---
import { site, nav } from '../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name"><span class="seal seal--sm" aria-hidden="true">米</span>{site.name}</p>
      <p class="site-footer__disclaimer" id="disclaimer">{site.disclaimer}</p>
    </div>
    <ul class="site-footer__nav" aria-label="フッターナビゲーション">
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>
