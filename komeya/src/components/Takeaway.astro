---
import { takeout, yen } from '../data/menu';
import { stories, site } from '../data/site';
import Photo from './Photo.astro';
---

<section class="takeaway" id="takeaway" aria-labelledby="takeaway-title">
  <div class="container takeaway__grid">
    <Photo name="gingerPork" ratio="4 / 3" sizes="(min-width: 900px) 480px, 100vw" />
    <div>
      <h2 id="takeaway-title" class="h2">{stories.takeaway.heading}</h2>
      <p>{stories.takeaway.body}</p>
      <ul class="dishes bento">
        {
          takeout.map((i) => (
            <li class="dish">
              <div class="dish__head">
                <span class="dish__name">{i.name}</span>
                <span class="dish__price">{yen(i.price)}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="takeaway__note">価格は税込です。お持ち帰り: {site.takeout}</p>
    </div>
  </div>
</section>
