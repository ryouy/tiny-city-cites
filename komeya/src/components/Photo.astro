---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { photos } from '../data/photos';
import type { PhotoKey } from '../data/menu';

interface Props {
  name: PhotoKey;
  /** ヒーローのみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。省略時は 4 / 3 */
  ratio?: string;
  /** 枠に合わせて切り取るときの基準位置(CSS object-position) */
  position?: string;
  sizes?: string;
}
const { name, priority = false, ratio = '4 / 3', position = '50% 50%', sizes = '(min-width: 900px) 560px, 100vw' } = Astro.props;
const def = photos[name];
// ビルド時に public/images/komeya/ の実ファイル(webp / png / jpg / jpeg)を探す。無ければプレースホルダー表示。
const dir = join(process.cwd(), 'public', 'images', 'komeya');
const found = ['webp', 'png', 'jpg', 'jpeg'].map((e) => `${def.file}.${e}`).find((f) => existsSync(join(dir, f)));
---

{
  found ? (
    <img
      class="photo"
      src={`${import.meta.env.BASE_URL}images/komeya/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={`aspect-ratio:${ratio};object-position:${position}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`photo photo--ph tone-${def.tone}`} style={`aspect-ratio:${ratio}`} role="img" aria-label={`画像準備中: ${def.shoot}`}>
      <span class="photo__tag">画像準備中</span>
    </div>
  )
}
