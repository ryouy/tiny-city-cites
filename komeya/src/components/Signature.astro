---
import { signatures, findItem, yen } from '../data/menu';
import Photo from './Photo.astro';
---

<section class="signature" id="signature" aria-labelledby="signature-title">
  <div class="container">
    <h2 id="signature-title" class="h2">名物料理</h2>
    <ul class="sig-list">
      {
        signatures.map((s) => {
          const item = findItem(s.menuName);
          return (
            <li class="sig reveal">
              <Photo name={s.photo} ratio="1 / 1" position="50% 55%" sizes="(min-width: 900px) 540px, 42vw" />
              <div class="sig__body">
                <h3 class="sig__name">{item.name}</h3>
                <p class="sig__price">{yen(item.price)}<small>税込</small></p>
                <p>{s.copy}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
