---
import { menu, menuNotes, yen } from '../data/menu';
import { stories } from '../data/site';
---

<section class="section menu" id="menu" aria-labelledby="menu-title">
  <div class="container">
    <p class="eyebrow">お品書き</p>
    <h2 id="menu-title" class="h2">お品書き<span class="h2__sub">税込価格</span></h2>

    <ul class="menu-rules" aria-label="ご注文前のご案内">
      <li>{menuNotes.tax}</li>
      <li>{menuNotes.set}</li>
      <li>{menuNotes.large}</li>
    </ul>
  </div>

  <nav class="menu-jump" aria-label="お品書きのカテゴリ">
    <div class="container">
      <ul>
        {menu.map((c) => <li><a href={`#menu-${c.id}`}>{c.title}</a></li>)}
        <li><a href="#takeaway">お持ち帰り</a></li>
      </ul>
    </div>
  </nav>

  <div class="container">
    {
      menu.map((c) => (
        <section class="cat" id={`menu-${c.id}`} aria-labelledby={`cat-${c.id}`}>
          <h3 class="cat__title" id={`cat-${c.id}`}>
            {c.title}
            {c.note && <small>{c.note}</small>}
          </h3>
          <ul class={`dishes${c.items.every((i) => !i.description) ? ' dishes--compact' : ''}`}>
            {c.items.map((i) => (
              <li class="dish">
                <div class="dish__head">
                  <h4 class="dish__name">
                    {i.name}
                    {i.tag && <span class="dish__tag">{i.tag}</span>}
                  </h4>
                  <span class="dish__price">{yen(i.price)}</span>
                </div>
                {i.description && <p class="dish__desc">{i.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <aside class="daily" id="daily" aria-labelledby="daily-title">
      <h3 class="daily__title" id="daily-title">{stories.daily.heading}</h3>
      <p>{stories.daily.body}</p>
    </aside>
  </div>
</section>
