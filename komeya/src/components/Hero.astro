---
import { site } from '../data/site';
import Photo from './Photo.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__photo">
    <Photo name="noren" priority ratio="16 / 9" position="50% 40%" sizes="100vw" />
  </div>
  <div class="container hero__body">
    <div class="hero__copy">
      <h1 id="hero-title">{site.catchcopy}</h1>
      <p class="hero__lead">{site.lead}</p>
      <p class="hero__cta">
        <a class="btn btn--primary" href="#menu">お品書きを見る</a>
        <a class="btn btn--text" href="#hours">営業時間を見る</a>
      </p>
    </div>
    <dl class="board" aria-label="営業時間">
      <div><dt>昼</dt><dd>{site.hours[0].open}–{site.hours[0].close}<small>L.O. {site.hours[0].lastOrder}</small></dd></div>
      <div><dt>夜</dt><dd>{site.hours[1].open}–{site.hours[1].close}<small>L.O. {site.hours[1].lastOrder}</small></dd></div>
      <div><dt>休</dt><dd>日曜<small>毎週</small></dd></div>
    </dl>
  </div>
</section>
