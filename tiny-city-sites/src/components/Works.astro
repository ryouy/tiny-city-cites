---
import { site } from '../config/site';
const { items, intro } = site.works;
---

{
  site.works.show && (
    <section class="section" id="works" aria-labelledby="works-title">
      <div class="container">
        <h2 id="works-title">制作事例</h2>
        <p class="section__intro">{intro}</p>
        {items.length === 0 ? (
          <p>制作サンプルは準備中です。</p>
        ) : (
          <ul class="works-grid">
            {items.map((w) => (
              <li>
                <a class="work" href={w.url}>
                  {w.thumbnail && (
                    <img src={w.thumbnail} alt="" width="1000" height="750" loading="lazy" decoding="async" />
                  )}
                  <span class="work__meta">{w.category}</span>
                  <span class="work__title">{w.title}</span>
                  <span class="work__desc">{w.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}
