---
import { site } from '../config/site';
const cta = site.contact.instagramUrl || '#contact';
const external = Boolean(site.contact.instagramUrl);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <img
    class="hero__bg"
    src="/images/mountain-lake.webp"
    alt=""
    width="1800"
    height="1305"
    fetchpriority="high"
    decoding="async"
  />
  <div class="container hero__inner">
    <h1 id="hero-title">
      会津大生がつくる、<br />街のお店のホームページ。
    </h1>
    <p class="hero__lead">
      大学で学んだことを、身近なお店のために。<br />
      学びと実績づくりを兼ねて、手頃な価格で制作しています。<br />
      まずは気軽に、ご相談ください。
    </p>
    <p class="hero__actions">
      <a
        class="btn btn--light"
        href={cta}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}>Instagramで相談する</a
      >
      <a class="textlink textlink--light" href="#works">制作事例を見る</a>
    </p>
  </div>
</section>
