---
import { site } from '../config/site';

const links = [
  ...(site.works.show ? [{ href: '#works', ja: '制作事例' }] : []),
  { href: '#services', ja: 'サービス' },
  { href: '#pricing', ja: '料金' },
  { href: '#flow', ja: '流れ' },
  { href: '#about', ja: '運営者' },
  { href: '#contact', ja: '相談' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="#top">{site.name}</a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.ja}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
