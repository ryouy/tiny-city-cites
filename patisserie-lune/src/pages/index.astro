---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Footer from '../components/Footer.astro';
import { hero, about, wholeCopy, giftCopy } from '../data/site';
import { cutCakes, yen } from '../data/menu';

const base = import.meta.env.BASE_URL;
const featured = cutCakes.filter((c) => c.photo);
---

<BaseLayout current="home">
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__photo">
        <Photo name="hero" priority ratio="4 / 3" position="50% 45%" sizes="100vw" />
      </div>
      <div class="wrap hero__row">
        <div>
          <h1 id="hero-title">{hero.copy}</h1>
          <p class="hero__sub">{hero.sub}</p>
        </div>
        <dl class="hero__hours">
          <div><dt>営業時間</dt><dd>10:00–18:00</dd></div>
          <div><dt>定休日</dt><dd>火曜日・水曜日</dd></div>
        </dl>
      </div>
    </section>

    <section class="sec" id="cakes" aria-labelledby="cakes-title">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="cakes-title">カットケーキ</h2>
          <a class="tlink" href={`${base}menu/`}>すべての商品を見る</a>
        </div>
        <ul class="showcase">
          {featured.map((c) => (
            <li>
              <Photo name={c.photo!} ratio="4 / 5" sizes="(min-width: 900px) 33vw, 100vw" />
              <div class="showcase__cap">
                <h3>{c.name}</h3>
                <p class="price">{yen(c.price)}<small>税込</small></p>
                <p class="showcase__desc">{c.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec sec--tight" aria-label="ホールケーキと焼き菓子">
      <div class="wrap duo">
        <article class="duo__item" id="whole-cakes" aria-labelledby="whole-title">
          <Photo name="wholeCake" ratio="1 / 1" sizes="(min-width: 900px) 50vw, 100vw" />
          <h2 id="whole-title">{wholeCopy.heading}</h2>
          <p>{wholeCopy.body}</p>
          <a class="tlink" href={`${base}order/`}>ホールケーキのページ</a>
        </article>
        <article class="duo__item" id="gifts" aria-labelledby="gift-title">
          <Photo name="gift" ratio="5 / 4" sizes="(min-width: 900px) 50vw, 100vw" />
          <h2 id="gift-title">{giftCopy.heading}</h2>
          <p>{giftCopy.body}</p>
          <a class="tlink" href={`${base}menu/#baked`}>焼き菓子の一覧</a>
        </article>
      </div>
    </section>

    <section class="sec" id="about" aria-labelledby="about-title">
      <div class="wrap story">
        <div class="story__photo"><Photo name="baker" ratio="4 / 5" sizes="(min-width: 900px) 440px, 100vw" /></div>
        <div class="story__text">
          <h2 id="about-title">{about.heading}</h2>
          <p>{about.body}</p>
          <a class="tlink" href={`${base}about/`}>営業情報・FAQ</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
