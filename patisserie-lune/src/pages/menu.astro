---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import MenuTabs from '../components/MenuTabs.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout current="menu" title="メニュー｜PÂTISSERIE LUNE" description="PÂTISSERIE LUNEのカットケーキ、ホールケーキ、焼き菓子の一覧。価格はすべて税込です。">
  <main id="main">
    <PageHead title="商品一覧" />
    <div class="page-body">
      <div class="wrap">
        <MenuTabs />
        <p class="notes">表示価格はすべて税込です。</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
