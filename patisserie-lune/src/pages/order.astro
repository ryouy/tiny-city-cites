---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import OrderDemo from '../components/OrderDemo.astro';
import Footer from '../components/Footer.astro';
import { wholeCopy } from '../data/site';
---

<BaseLayout current="order" title="Whole Cakes｜PÂTISSERIE LUNE（架空店舗の制作デモ）" description="ホールケーキのご案内と予約フローのデモ。サイズ・商品・受取日・メッセージプレートの流れを体験できますが、実際の予約・注文は受け付けていません。">
  <main id="main">
    <PageHead en="Whole Cakes" title={wholeCopy.heading} lead={wholeCopy.body} />
    <div class="page-body">
      <div class="wrap">
        <p class="demo-note" style="margin-top:0">{wholeCopy.note} 以下は、ブラウザ内だけで動くデモです。</p>
        <ol class="flow" style="margin-top:40px">
          <li><div><b>商品とサイズ</b><span>デコレーションとサイズを選びます。</span></div></li>
          <li><div><b>受取希望日</b><span>定休日を除く営業日から選びます。</span></div></li>
          <li><div><b>メッセージプレート</b><span>添えたい文面を入力します（任意）。</span></div></li>
          <li><div><b>内容の確認</b><span>デモのため、ここで終了します。送信はされません。</span></div></li>
        </ol>
        <OrderDemo />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
