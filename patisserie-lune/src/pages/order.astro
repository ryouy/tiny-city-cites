---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import OrderDemo from '../components/OrderDemo.astro';
import Footer from '../components/Footer.astro';
import { wholeCopy } from '../data/site';
---

<BaseLayout current="order" title="ホールケーキ｜PÂTISSERIE LUNE（架空店舗の制作デモ）" description="PÂTISSERIE LUNEのホールケーキ。商品とサイズ、受取希望日、メッセージプレートを選べます。予約機能はデモで、送信されません。">
  <main id="main">
    <PageHead title={wholeCopy.heading} lead={wholeCopy.body} />
    <div class="page-body">
      <div class="wrap">
        <p class="demo-note">{wholeCopy.note}</p>
        <OrderDemo />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
