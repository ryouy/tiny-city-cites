---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Footer from '../components/Footer.astro';
import { story, infoRows, faq } from '../data/site';
---

<BaseLayout current="about" title="店舗案内｜PÂTISSERIE LUNE" description="PÂTISSERIE LUNEの営業時間、定休日、駐車場、お支払い方法、よくあるご質問。">
  <main id="main">
    <PageHead title="店舗案内" />

    <section class="sec sec--tight" aria-labelledby="story-title">
      <div class="wrap story story--rev">
        <div class="story__text">
          <h2 id="story-title">お店について</h2>
          {story.paras.map((t) => <p>{t}</p>)}
        </div>
        <div class="story__photo"><Photo name="shop" ratio="4 / 5" sizes="(min-width: 900px) 440px, 100vw" /></div>
      </div>
    </section>

    <section class="sec sec--tight" id="info" aria-labelledby="info-title">
      <div class="wrap info">
        <div>
          <h2 id="info-title">営業情報</h2>
          <dl class="dl">
            {infoRows.map((r) => (
              <div><dt>{r.k}</dt><dd>{r.v.map((t) => <span>{t}</span>)}</dd></div>
            ))}
          </dl>
        </div>
        <div class="info__map">
          <MapEmbed />
        </div>
      </div>
    </section>

    <section class="sec sec--tight" aria-labelledby="faq-title">
      <div class="wrap faq-wrap">
        <h2 class="h-sub" id="faq-title">よくあるご質問</h2>
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
