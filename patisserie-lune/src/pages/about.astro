---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Footer from '../components/Footer.astro';
import { story, infoRows, faq } from '../data/site';
---

<BaseLayout current="about" title="店舗案内｜PÂTISSERIE LUNE（架空店舗の制作デモ）" description="PÂTISSERIE LUNEのお店について、営業時間・定休日・駐車場・お支払い方法、よくあるご質問。具体的な住所・電話番号は設けていません。">
  <main id="main">
    <PageHead title="店舗案内" />

    <section class="sec sec--tight" aria-labelledby="story-title">
      <div class="wrap story story--rev">
        <div class="story__text">
          <h2 id="story-title">お店について</h2>
          {story.paras.map((t) => <p>{t}</p>)}
          <p class="small">{story.fiction}</p>
        </div>
        <div class="story__photo"><Photo name="baker" ratio="4 / 5" position="50% 55%" sizes="(min-width: 900px) 400px, 100vw" /></div>
      </div>
    </section>

    <section class="sec sec--tint" id="info" aria-labelledby="info-title">
      <div class="wrap info">
        <div class="info__photo"><Photo name="shop" ratio="4 / 5" position="50% 60%" sizes="(min-width: 900px) 400px, 100vw" /></div>
        <div>
          <h2 id="info-title">営業情報</h2>
          <dl class="dl">
            {infoRows.map((r) => (
              <div><dt>{r.k}</dt><dd>{r.v.map((t) => <span>{t}</span>)}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="sec" aria-label="地図とよくあるご質問">
      <div class="wrap access-grid">
        <div>
          <h2 class="h-sub">エリアの目安</h2>
          <MapEmbed />
        </div>
        <div>
          <h2 class="h-sub">よくあるご質問</h2>
          <div class="faq">
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
