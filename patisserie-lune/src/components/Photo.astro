---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { photos, photoExts } from '../data/photos';
import type { PhotoKey } from '../data/menu';

interface Props {
  name: PhotoKey;
  /** 先頭の大きな写真のみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。省略時は 4 / 5 */
  ratio?: string;
  sizes?: string;
  /** 切り出し位置(object-position)。例: '50% 30%' */
  position?: string;
}
const { name, priority = false, ratio = '4 / 5', sizes = '(min-width: 900px) 50vw, 100vw', position = '50% 50%' } = Astro.props;
const def = photos[name];
// ビルド時に public/images/patisserie-lune/ の実ファイル(webp/png/jpg/jpeg/avif)を確認。無ければ控えめな単色面。
const found = photoExts
  .map((e) => `${def.base}.${e}`)
  .find((f) => existsSync(join(process.cwd(), 'public', 'images', 'patisserie-lune', f)));
---

{
  found ? (
    <img
      class="photo"
      src={`${import.meta.env.BASE_URL}images/patisserie-lune/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={`aspect-ratio:${ratio};object-position:${position}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class="photo photo--ph" style={`aspect-ratio:${ratio}`} role="img" aria-label={`画像準備中。${def.alt}`}>
      <span>画像準備中</span>
    </div>
  )
}
