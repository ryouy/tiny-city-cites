---
import Photo from './Photo.astro';
import { cutCakes, wholeCakes, bakedGoods, yen } from '../data/menu';

const withPhoto = cutCakes.filter((c) => c.photo);
const noPhoto = cutCakes.filter((c) => !c.photo);
const tabs = [
  { id: 'cut', ja: 'ケーキ' },
  { id: 'whole', ja: 'ホール' },
  { id: 'baked', ja: '焼き菓子' },
];
---

<div class="menu-tabs" data-tabs>
  <div class="tabs" role="tablist" aria-label="商品カテゴリ">
    {tabs.map((t, i) => (
      <button class="tab" role="tab" type="button" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        {t.ja}
      </button>
    ))}
  </div>

  <section class="panel" role="tabpanel" id="panel-cut" aria-labelledby="tab-cut" tabindex="0">
    <h2 class="visually-hidden">カットケーキ</h2>
    <ul class="grid">
      {withPhoto.map((c) => (
        <li class="card">
          <Photo name={c.photo!} ratio="4 / 5" sizes="(min-width: 900px) 33vw, (min-width: 560px) 50vw, 100vw" />
          <h3 class="card__name">{c.name}</h3>
          <p class="card__desc">{c.desc}</p>
          <p class="price">{yen(c.price)}<small>税込</small></p>
        </li>
      ))}
    </ul>
    <ul class="rows rows--more">
      {noPhoto.map((c) => (
        <li class="row">
          <h3 class="row__name">{c.name}</h3>
          <p class="row__sub">{c.desc}</p>
          <p class="price">{yen(c.price)}<small>税込</small></p>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel" role="tabpanel" id="panel-whole" aria-labelledby="tab-whole" tabindex="0">
    <h2 class="visually-hidden">ホールケーキ</h2>
    <div class="split">
      <div class="split__photo split__photo--round"><Photo name="wholeCake" ratio="1 / 1" sizes="(min-width: 900px) 45vw, 100vw" /></div>
      <div>
        <ul class="rows">
          {wholeCakes.map((w) => (
            <li class="row">
              <h3 class="row__name">{w.name}</h3>
              <p class="row__sub">{w.size}</p>
              <p class="row__meta">{w.note}</p>
              <p class="price">{yen(w.price)}<small>税込</small></p>
            </li>
          ))}
        </ul>
        <p class="panel__note">ご予約は受取希望日の3営業日前までにお願いします。</p>
        <a class="btn" href={`${import.meta.env.BASE_URL}order/`}>ホールケーキを見る</a>
      </div>
    </div>
  </section>

  <section class="panel" role="tabpanel" id="panel-baked" aria-labelledby="tab-baked" tabindex="0">
    <h2 class="visually-hidden">焼き菓子</h2>
    <div class="split">
      <div class="split__photo"><Photo name="gift" ratio="5 / 4" sizes="(min-width: 900px) 45vw, 100vw" /></div>
      <ul class="rows">
        {bakedGoods.map((b) => (
          <li class="row">
            <h3 class="row__name">{b.name}</h3>
            <p class="row__sub">{b.desc}</p>
            <p class="price">{yen(b.price)}<small>税込</small></p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % n;
        else if (e.key === 'ArrowLeft') to = (i - 1 + n) % n;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = n - 1;
        if (to >= 0) {
          e.preventDefault();
          select(to, true);
        }
      });
    });
    select(Math.max(0, ['#cut', '#whole', '#baked'].indexOf(location.hash)));
  }
</script>
