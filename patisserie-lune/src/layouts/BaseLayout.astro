---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 現在のページ(ナビの現在地表示) */
  current?: 'home' | 'about' | 'menu' | 'order';
}
const { title = site.title, description = site.description, current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`;
const currentKey: Record<string, string> = { about: 'about/', menu: 'menu/', order: 'order/' };
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#F9F5F0" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={href('og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <div class="top">
      <header class="site-header">
        <a class="logo" href={href('')} aria-label="PÂTISSERIE LUNE トップページへ">PÂTISSERIE <b>LUNE</b></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="nav-toggle__label">メニュー</span>
          <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="メインナビゲーション">
          <ul>
            <li class="site-nav__home"><a href={href('')} aria-current={current === 'home' ? 'page' : undefined}>トップ</a></li>
            {nav.map((n) => (
              <li>
                <a href={href(n.href)} aria-current={currentKey[current] === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
    </div>

    <slot />

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      const top = document.querySelector<HTMLElement>('.top');
      const desktop = window.matchMedia('(min-width: 900px)');

      const setOpen = (open: boolean, returnFocus = false) => {
        if (!toggle || !nav) return;
        toggle.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('nav-open', open);
        if (!open && returnFocus) toggle.focus();
      };
      toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      nav?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true);
      });
      document.addEventListener('click', (e) => {
        if (toggle?.getAttribute('aria-expanded') === 'true' && top && !top.contains(e.target as Node)) setOpen(false);
      });
      desktop.addEventListener('change', () => setOpen(false));

      // 写真のふわっと表示(reduced-motion では即表示)
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => {
              if (en.isIntersecting) {
                en.target.classList.add('is-in');
                io.unobserve(en.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
