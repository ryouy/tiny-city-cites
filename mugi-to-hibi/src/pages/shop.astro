---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Calendar from '../components/Calendar.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { pages, about, commitments, commitmentsHeading, shopInfo } from '../data/site';
---

<BaseLayout current="shop" title={pages.shop.title} description={pages.shop.description}>
  <div class="page-head">
   <div class="wrap page-head__in">
    <h1 class="page-title">お店のこと</h1>
    <ul class="jump" aria-label="このページの内容">
      <li><a href="#about">お店について</a></li>
      <li><a href="#commitment">材料と作り方</a></li>
      <li><a href="#calendar">営業カレンダー</a></li>
      <li><a href="#info">店舗案内</a></li>
    </ul>
   </div>
  </div>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <div class="about__photo"><Photo name="process" ratio="3 / 2" ratioSm="3 / 2" sizes="(min-width: 900px) 55vw, 100vw" /></div>
      <div class="about__text">
        <h2 id="about-title" class="h2">{about.heading}</h2>
        <p>{about.story}</p>
        <p class="about__owner">{about.owner}</p>
      </div>
    </div>
  </section>

  <section class="section commitment on-green" id="commitment" aria-labelledby="commitment-title">
    <div class="wrap commit__grid">
      <h2 id="commitment-title" class="h2">{commitmentsHeading}</h2>
      <dl class="commit">
        {commitments.map((c) => (
          <div class="commit__row"><dt>{c.title}</dt><dd>{c.body}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <Calendar />

  <section class="section shop" id="info" aria-labelledby="shop-title">
    <div class="wrap">
      <h2 id="shop-title" class="h2">店舗案内</h2>
      <div class="shop__grid">
        <div>
          <dl class="info">
            {shopInfo.map((r) => (
              <div class="info__row"><dt>{r.term}</dt><dd>{r.desc}</dd></div>
            ))}
          </dl>
        </div>
        <MapEmbed />
      </div>
    </div>
  </section>
</BaseLayout>
