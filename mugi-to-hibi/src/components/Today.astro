---
import { bakeSchedule, todayNotice } from '../data/bakery';
import { news } from '../data/site';
---

<section class="section today" id="today" aria-labelledby="today-title">
  <div class="wrap today__grid">
    <div class="today__main">
      <header class="section-head reveal">
        <p class="eyebrow">Today's Bake</p>
        <h2 id="today-title" class="h2">今日の焼き上がり</h2>
        <p class="notice" role="note"><span class="oval oval--solid">デモ用サンプル</span> {todayNotice}</p>
      </header>
      <table class="bake reveal">
        <caption class="sr-only">今日の焼き上がり予定（架空のサンプル）</caption>
        <thead class="sr-only"><tr><th scope="col">時間</th><th scope="col">商品</th><th scope="col">表示</th></tr></thead>
        <tbody>
          {bakeSchedule.map((r) => (
            <tr>
              <th scope="row" class="bake__time">{r.time}</th>
              <td class="bake__items">{r.items}</td>
              <td class="bake__status">{r.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="today__how reveal">営業時間は8:00–16:00、売り切れ次第終了です。表の時間は「焼き上がり予定」の目安として並べたサンプルで、売り切れ・焼き上がりの状況はこのサイトでは表示しません。</p>
    </div>
    <aside class="news reveal" aria-labelledby="news-title">
      <h3 id="news-title" class="news__title"><span class="eyebrow">News</span> お知らせ</h3>
      <ul>
        {news.map((n) => (
          <li><span class="oval oval--solid">デモ用サンプル</span><span>{n.text}</span></li>
        ))}
      </ul>
    </aside>
  </div>
</section>
