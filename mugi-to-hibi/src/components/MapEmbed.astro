---
// 会津若松市の目安として鶴ヶ城周辺を表示する小さな地図。店舗は架空のため、店舗の所在地ではない。
const src =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2937.6912386927056!2d139.92812177790756!3d37.48734966694757!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5ff554974e2fffbb%3A0x677cc0bc9a812e8b!2sTsuruga-jo%20Castle%20(Aizu-wakamatsu-jo)!5e1!3m2!1sen!2sjp!4v1791875652272!5m2!1sen!2sjp';
---

<figure class="map-embed">
  <iframe
    src={src}
    title="会津若松市周辺の地図（鶴ヶ城付近）"
    width="600"
    height="450"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
  <figcaption>
    地図は会津若松市のおおよその目安として、鶴ヶ城周辺を表示しています。店舗の所在地ではありません（架空店舗）。
  </figcaption>
</figure>

<style>
  .map-embed {
    margin: 0;
  }
  .map-embed iframe {
    display: block;
    width: 100%;
    height: clamp(220px, 60vw, 320px);
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 22%, transparent);
    background: color-mix(in srgb, currentColor 6%, transparent);
  }
  .map-embed figcaption {
    margin-top: 10px;
    font-size: 0.75rem;
    line-height: 1.7;
    opacity: 0.8;
  }
</style>
