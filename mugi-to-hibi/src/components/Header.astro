---
import { site, nav, href, type PageKey } from '../data/site';

interface Props { current: PageKey }
const { current } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="logo" href={href()} aria-current={current === 'home' ? 'page' : undefined} aria-label={`${site.name}（${site.en}） トップページ`}>
      <span class="logo__jp">{site.name}</span>
      <span class="logo__en" aria-hidden="true">{site.en}</span>
    </a>
    <nav class="site-nav" aria-label="主要ナビゲーション">
      <ul>
        {nav.map((n) => (
          <li><a href={href(n.path)} aria-current={n.current === current ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
