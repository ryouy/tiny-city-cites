---
import { site, nav } from '../data/site';
---

<div class="top" data-top>
  <p class="demo-band" role="note">
    <span class="demo-band__tag">DEMO</span>
    <span>{site.bandText}</span>
  </p>
  <header class="site-header" data-site-header>
    <div class="site-header__inner">
      <a class="logo" href="#top" aria-label={`${site.name}（${site.en}） トップへ`}>
        <span class="logo__jp">{site.name}</span>
        <span class="logo__en" aria-hidden="true">{site.en}</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle__label">メニュー</span>
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="主要ナビゲーション">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const label = toggle?.querySelector('.nav-toggle__label');

  const setMenu = (open: boolean) => {
    if (!toggle || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? '閉じる' : 'メニュー';
    header.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (header && toggle?.getAttribute('aria-expanded') === 'true' && !header.contains(e.target as Node)) setMenu(false);
  });
  // デスクトップ幅に広がったらメニュー状態をリセット
  window.matchMedia('(min-width: 900px)').addEventListener('change', () => setMenu(false));
</script>
