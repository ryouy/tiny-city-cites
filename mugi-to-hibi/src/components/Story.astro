---
import { about } from '../data/site';
import Photo from './Photo.astro';
import Wheat from './Wheat.astro';
---

<section class="section story" id="about" aria-labelledby="about-title">
  <div class="wrap story__grid">
    <div class="story__photo reveal">
      <Photo name="process" ratio="3 / 2" ratioSm="3 / 2" sizes="(min-width: 900px) 50vw, 100vw" />
    </div>
    <div class="story__text reveal">
      <p class="eyebrow">About</p>
      <h2 id="about-title" class="h2">{about.heading}</h2>
      <p class="lead-text">{about.body}</p>
      <p>{about.story}</p>
      <div class="owner">
        <Wheat class="owner__wheat" />
        <p>{about.owner}<span class="owner__note">{about.ownerNote}</span></p>
      </div>
    </div>
  </div>
</section>
