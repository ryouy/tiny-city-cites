---
import { site, hero } from '../data/site';
import Photo from './Photo.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media">
    <Photo name="hero" ratio="16 / 9" ratioSm="5 / 4" eager sizes="100vw" />
  </div>
  <div class="wrap hero__wrap">
    <div class="hero__panel">
      <p class="eyebrow">{hero.label}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="nb">パンのある日々を、</span><span class="nb">もっと豊かに。</span>
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <p class="hero__sub">{site.subtitle}</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn--line" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
      <p class="hero__note">{hero.note}</p>
    </div>
  </div>
</section>
