---
import { site, nav } from '../data/site';
import Wheat from './Wheat.astro';
---

<footer class="site-footer">
  <div class="wrap">
    <Wheat class="footer__wheat" />
    <p class="footer__name"><span>{site.name}</span> <small>{site.en}</small></p>
    <p class="footer__disclaimer">{site.disclaimer}</p>
    <nav aria-label="フッターナビゲーション">
      <ul class="footer__nav">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="#top">ページの先頭へ</a></li>
      </ul>
    </nav>
    <p class="footer__copy">店名・人物・所在地・商品・営業条件はすべて架空の設定です。実在の店舗・ブランドとは関係ありません。</p>
  </div>
</footer>
