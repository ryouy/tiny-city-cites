---
import { site, nav, href, type PageKey } from '../data/site';

interface Props { current: PageKey }
const { current } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer__name">{site.name}<small>{site.en}</small></p>
    <nav aria-label="フッターナビゲーション">
      <ul class="footer__nav">
        <li><a href={href()} aria-current={current === 'home' ? 'page' : undefined}>トップ</a></li>
        {nav.map((n) => (
          <li><a href={href(n.path)} aria-current={n.current === current ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="footer__disclaimer">{site.disclaimer}</p>
  </div>
</footer>
