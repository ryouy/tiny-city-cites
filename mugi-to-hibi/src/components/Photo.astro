---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { imageDir, photos, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  /** CSS aspect-ratio 形式 例: "4 / 5" */
  ratio?: string;
  /** スマホ(〜639px)での比率 */
  ratioSm?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { name, ratio = '4 / 3', ratioSm, eager = false, sizes = '100vw', class: className = '' } = Astro.props;
const photo = photos[name];

// ビルド時に実ファイルの有無と拡張子を判定する
const exts = ['webp', 'png', 'jpg', 'jpeg', 'avif'];
const ext = exts.find((e) => existsSync(join(process.cwd(), 'public', imageDir, `${photo.stem}.${e}`)));
const style = `--r:${ratio};--r-sm:${ratioSm ?? ratio};--pos:${photo.pos}`;
const cls = ['photo', `tone-${photo.tone}`, className].filter(Boolean).join(' ');
---

{
  ext ? (
    <div class={cls} style={style}>
      <img
        src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${imageDir}${photo.stem}.${ext}`}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding={eager ? 'sync' : 'async'}
      />
    </div>
  ) : (
    <div class={`${cls} photo--placeholder`} style={style} role="img" aria-label={`画像準備中：${photo.shot}`}>
      <span class="photo__status" aria-hidden="true">画像準備中</span>
    </div>
  )
}
