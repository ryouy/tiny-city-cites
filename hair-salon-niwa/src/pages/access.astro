---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import AccessInfo from '../components/AccessInfo.astro';
import { path, site } from '../data/site';
---

<BaseLayout page="Access｜アクセス・店舗情報" description="HAIR SALON niwa（架空店舗デモ）の営業時間・定休日・駐車場・所在エリア。架空設定のため住所・電話番号は掲載していません。">
  <PageHead en="Access" ja="アクセス・店舗情報（架空設定）" lead="住所・電話番号は設定していません（架空店舗のため）。完全予約制です。" />
  <div class="page-body">
    <div class="wrap">
      <AccessInfo />
      <ul class="note-list">
        <li>最終受付の時刻は目安です。施術内容により変動します。</li>
        <li>すべて架空の設定です。実際の営業案内として使用しないでください。</li>
      </ul>
      <p style="margin-top:40px"><a class="btn btn--solid" href={path('reserve')}>{site.cta}</a></p>
    </div>
  </div>
</BaseLayout>
