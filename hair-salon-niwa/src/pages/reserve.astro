---
import BaseLayout from '../layouts/BaseLayout.astro';
import { staff } from '../data/staff';
import { categories, services } from '../data/services';

const stepNames = [
  { en: 'Staff', ja: 'スタッフ' },
  { en: 'Menu', ja: 'メニュー' },
  { en: 'Date', ja: '日時' },
  { en: 'Confirm', ja: '内容確認' },
];
const times = ['09:30', '11:00', '13:30', '15:00'];
---

<BaseLayout page="ご予約" description="HAIR SALON niwaの予約ページ。スタッフ、メニュー、日時を選びます。入力内容は送信・保存されず、予約は成立しません。">
  <div class="page-body">
    <div class="wrap wrap--narrow">
      <h1 class="ptitle">ご予約</h1>
      <p class="ptitle__note">入力内容は送信・保存されません。予約は成立しません。</p>

      <div class="wiz" id="wiz" data-labels={JSON.stringify(stepNames.map((s) => s.ja))}>
        <ol class="wiz__steps" id="wiz-steps" aria-label="進行状況">
          {stepNames.map((s, i) => (
            <li aria-current={i === 0 ? 'step' : undefined}>{s.ja}</li>
          ))}
        </ol>

        <section class="wiz__panel" data-step="0" aria-labelledby="w0">
          <h2 id="w0" tabindex="-1">担当スタッフを選ぶ</h2>
          <fieldset>
            <legend class="visually-hidden">担当スタッフ</legend>
            <div class="opt-list">
              <label class="opt"><input type="radio" name="staff" value="any" data-label="指名なし" /><span class="opt__box"><span class="opt__name">指名なし</span><span class="opt__sub">おまかせ</span></span></label>
              {staff.map((p) => (
                <label class="opt"><input type="radio" name="staff" value={p.id} data-label={p.name} /><span class="opt__box"><span class="opt__name">{p.name}</span><span class="opt__sub">{p.role}／{p.strengths.join('、')}</span></span></label>
              ))}
            </div>
          </fieldset>
        </section>

        <section class="wiz__panel" data-step="1" aria-labelledby="w1" hidden>
          <h2 id="w1" tabindex="-1">メニューを選ぶ</h2>
          <fieldset>
            <legend class="visually-hidden">メニュー</legend>
            {categories.map((c) => (
              <div>
                <h3 class="cat-title">{c.ja}</h3>
                <div class="opt-list">
                  {services.filter((s) => s.category === c.key).map((m) => (
                    <label class="opt"><input type="radio" name="menu" value={m.id} data-label={m.name} data-price={m.price} data-duration={m.duration} data-note={m.note} /><span class="opt__box"><span class="opt__name">{m.name}</span><span class="opt__sub">{m.duration}／{m.note}</span><span class="opt__price">{m.price}</span></span></label>
                  ))}
                </div>
              </div>
            ))}
          </fieldset>
        </section>

        <section class="wiz__panel" data-step="2" aria-labelledby="w2" hidden>
          <h2 id="w2" tabindex="-1">希望日・時刻とお名前</h2>
          <fieldset>
            <legend class="sub-h">希望日</legend>
            <div class="dates" id="dates"></div>
          </fieldset>
          <fieldset>
            <legend class="sub-h" >希望時刻</legend>
            <div class="times">
              {times.map((t) => (
                <label class="opt"><input type="radio" name="time" value={t} data-label={t} /><span class="opt__box"><b>{t}</b></span></label>
              ))}
            </div>
          </fieldset>
          <div class="field">
            <label for="f-name">お名前</label>
            <input id="f-name" type="text" name="guest-name" autocomplete="off" maxlength="30" placeholder="例：山田 花子" />
          </div>
        </section>

        <section class="wiz__panel" data-step="3" aria-labelledby="w3" hidden>
          <h2 id="w3" tabindex="-1">内容を確認する</h2>
          <dl class="confirm">
            <div><dt>スタッフ</dt><dd id="c-staff"></dd></div>
            <div><dt>メニュー</dt><dd id="c-menu"></dd></div>
            <div><dt>料金・所要</dt><dd id="c-price"></dd></div>
            <div><dt>希望日時</dt><dd id="c-date"></dd></div>
            <div><dt>お名前</dt><dd id="c-name"></dd></div>
          </dl>
          <p class="wiz__final">この内容は送信されません。予約は成立していません。</p>
        </section>

        <p class="wiz__err" id="wiz-err" role="alert"></p>
        <div class="wiz__nav" id="wiz-nav">
          <button type="button" class="btn btn--line" id="back" hidden>戻る</button>
          <button type="button" class="btn btn--solid" id="next">次へ</button>
          <button type="button" class="btn btn--line" id="restart" hidden>最初からやり直す</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.getElementById('wiz')!;
  const panels = [...root.querySelectorAll<HTMLElement>('.wiz__panel[data-step]')];
  const stepEls = [...document.querySelectorAll<HTMLElement>('#wiz-steps li')];
  const back = document.getElementById('back') as HTMLButtonElement;
  const next = document.getElementById('next') as HTMLButtonElement;
  const err = document.getElementById('wiz-err')!;
  const restart = document.getElementById('restart') as HTMLButtonElement;
  const nameInput = document.getElementById('f-name') as HTMLInputElement;
  let step = 0;

  const checked = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);

  // 選択できる日付(翌日から。月曜日・第1/第3日曜日を除く)
  const dates = document.getElementById('dates')!;
  const wk = ['日', '月', '火', '水', '木', '金', '土'];
  const d = new Date();
  let n = 0;
  while (n < 10) {
    d.setDate(d.getDate() + 1);
    const day = d.getDay();
    const dom = d.getDate();
    if (day === 1 || (day === 0 && (dom <= 7 || (dom >= 15 && dom <= 21)))) continue;
    n++;
    const label = `${d.getMonth() + 1}月${dom}日（${wk[day]}）`;
    const l = document.createElement('label');
    l.className = 'opt';
    l.innerHTML = '<input type="radio" name="date"><span class="opt__box"><b></b><span class="opt__sub"></span></span>';
    const inp = l.querySelector('input')!;
    inp.value = label;
    inp.dataset.label = label;
    l.querySelector('b')!.textContent = `${d.getMonth() + 1}/${dom}`;
    l.querySelector('.opt__sub')!.textContent = `${wk[day]}曜日`;
    dates.appendChild(l);
  }

  const show = (i: number, focus = true) => {
    step = i;
    panels.forEach((p, j) => (p.hidden = j !== i));
    stepEls.forEach((s, j) => {
      if (j === i) s.setAttribute('aria-current', 'step');
      else s.removeAttribute('aria-current');
      s.classList.toggle('is-done', j < i);
    });
    back.hidden = i === 0;
    next.hidden = i === 3;
    restart.hidden = i !== 3;
    err.textContent = '';
    if (focus) panels[i].querySelector<HTMLElement>('h2')?.focus();
  };

  const confirmFill = () => {
    const m = checked('menu')!;
    (document.getElementById('c-staff') as HTMLElement).textContent = checked('staff')!.dataset.label ?? '';
    (document.getElementById('c-menu') as HTMLElement).textContent = m.dataset.label ?? '';
    (document.getElementById('c-price') as HTMLElement).textContent = `${m.dataset.price}／${m.dataset.duration}（${m.dataset.note}）`;
    (document.getElementById('c-date') as HTMLElement).textContent = `${checked('date')!.dataset.label} ${checked('time')!.dataset.label}`;
    (document.getElementById('c-name') as HTMLElement).textContent = nameInput.value.trim();
  };

  const validate = (): string => {
    if (step === 0 && !checked('staff')) return 'スタッフを選んでください。';
    if (step === 1 && !checked('menu')) return 'メニューを選んでください。';
    if (step === 2) {
      if (!checked('date')) return '希望日を選んでください。';
      if (!checked('time')) return '希望時刻を選んでください。';
      if (!nameInput.value.trim()) return 'お名前を入力してください。';
    }
    return '';
  };

  next.addEventListener('click', () => {
    const msg = validate();
    if (msg) { err.textContent = msg; return; }
    if (step === 2) confirmFill();
    show(step + 1);
  });
  back.addEventListener('click', () => show(step - 1));
  nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); next.click(); } });
  restart.addEventListener('click', () => {
    root.querySelectorAll<HTMLInputElement>('input').forEach((i) => { if (i.type === 'radio') i.checked = false; else i.value = ''; });
    show(0);
  });

  // クエリでの事前選択(例: ?menu=cut01&staff=saeki)
  const qs = new URL(location.href).searchParams;
  const pre = (name: string, v: string | null) => {
    const i = v ? root.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(v)}"]`) : null;
    if (i) i.checked = true;
    return !!i;
  };
  const hasStaff = pre('staff', qs.get('staff'));
  const hasMenu = pre('menu', qs.get('menu'));
  show(hasStaff ? (hasMenu ? 2 : 1) : 0, false);
</script>
