---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import { firstVisit, flow, site, path, about } from '../data/site';
import { faq } from '../data/faq';
---

<BaseLayout page="First Visit｜はじめての方へ" description="HAIR SALON niwa（架空店舗デモ）をはじめてご利用の方へ。来店の流れ、カウンセリングのこと、よくある質問を掲載しています。">
  <PageHead en="First Visit" ja={firstVisit.heading} lead={firstVisit.body} />
  <div class="page-body">
    <div class="wrap">
      <div class="fv-page">
        <div class="fv-page__flow">
          <h2>Flow｜来店の流れ（デモ設定）</h2>
          <ol class="steps">
            {flow.map((s) => (
              <li><span class="steps__no" aria-hidden="true">{s.no}</span><h3>{s.title}</h3><p>{s.body}</p></li>
            ))}
          </ol>

          <h2 style="margin-top:64px">Counseling｜カウンセリングについて</h2>
          <p class="lead">{about.body}</p>
        </div>
        <div class="fv-page__side">
          <Photo name="interior" ratio="4 / 5" sizes="(min-width: 960px) 40vw, 100vw" label="Interior" />
        </div>
      </div>

      <div style="margin-top:clamp(56px,8vw,112px)">
        <h2 class="sh__en" style="font-size:clamp(2.25rem,6vw,4rem);margin-bottom:28px" lang="en">FAQ</h2>
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary><span class="faq__q"><i aria-hidden="true">Q</i><span>{f.q}</span></span></summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div class="cta-strip on-dark" style="padding-inline:var(--gut);margin-inline:calc(var(--gut)*-1)">
        <p>まずは、予約デモをお試しください。</p>
        <a class="btn btn--solid" href={path('reserve')}>{site.cta}</a>
      </div>
    </div>
  </div>
</BaseLayout>
