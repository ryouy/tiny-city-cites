---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import StyleTile from '../components/StyleTile.astro';
import { site, about, concepts, firstVisit, infoRows, path } from '../data/site';
import { previewIds, priceRange, byId } from '../data/services';
import { hairStyles, featuredStyleIds } from '../data/styles';
import { staff } from '../data/staff';
const preview = previewIds.map((id) => byId(id)!);
const featured = featuredStyleIds.map((id) => hairStyles.find((s) => s.id === id)!);
const hours = infoRows.filter((r) => ['営業時間', '定休日'].includes(r.k));
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero__media">
      <Photo name="hero" priority ratio="3 / 2" sizes="100vw" position="50% 55%" />
    </div>
    <div class="wrap hero__text">
      <div>
        <p class="hero__en" lang="en">{site.heroEn}</p>
        <h1 id="hero-h"><span class="nw">髪から、</span><span class="nw">日々を心地よく。</span></h1>
      </div>
      <div>
        <p class="hero__sub">{site.heroSub}</p>
        <p class="hero__cta">
          <a class="btn btn--solid" href={path('menu')}>メニュー・料金を見る</a>
          <a class="textlink" href={path('styles')}>スタイルを見る</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section about" aria-labelledby="about-h">
    <div class="wrap about__grid">
      <div class="about__media"><Photo name="interior" ratio="4 / 5" sizes="(min-width: 900px) 40vw, 100vw" position="50% 40%" /></div>
      <div class="about__text">
        <h2 id="about-h">{about.heading}</h2>
        <p>{about.body}</p>
        <dl class="concepts">
          {concepts.map((c) => <div><dt>{c.title}</dt><dd>{c.body}</dd></div>)}
        </dl>
        <h3 class="first">{firstVisit.heading}</h3>
        <p>{firstVisit.body}</p>
        <p><a class="textlink" href={`${path('access')}#faq`}>よくある質問</a></p>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="styles-h">
    <div class="wrap">
      <div class="row-head">
        <h2 id="styles-h">スタイル</h2>
        <a class="textlink" href={path('styles')}>すべて見る</a>
      </div>
      <ul class="feat">
        {featured.map((s) => <li><StyleTile style={s} href={`${path('styles')}#${s.id}`} sizes="(min-width: 900px) 25vw, 50vw" /></li>)}
      </ul>
    </div>
  </section>

  <section class="section menu-prev" aria-labelledby="menu-h">
    <div class="wrap menu-prev__grid">
      <div class="menu-prev__head">
        <h2 id="menu-h">メニュー・料金</h2>
        <p class="menu-prev__range">{priceRange}</p>
        <p class="more"><a class="textlink" href={path('menu')}>メニュー・料金をすべて見る</a></p>
      </div>
      <div>
        <ul class="mlist">
          {preview.map((m) => (
            <li class="mrow">
              <span class="mrow__name">{m.name}</span>
              <span class="mrow__meta"><span>{m.duration}</span><span>{m.note}</span></span>
              <span class="mrow__price">{m.price}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight bottom" aria-labelledby="bottom-h">
    <div class="wrap bottom__grid">
      <div>
        <h2 id="bottom-h">スタッフ</h2>
        <ul class="plain">
          {staff.map((p) => <li><strong>{p.name}</strong> {p.role}</li>)}
        </ul>
        <p class="more"><a class="textlink" href={path('staff')}>スタッフ紹介</a></p>
      </div>
      <div>
        <h2 class="h2-like">営業時間</h2>
        <dl class="info info--small">
          {hours.map((r) => <div><dt>{r.k}</dt><dd>{r.v.map((l) => <p>{l}</p>)}</dd></div>)}
        </dl>
        <p class="more"><a class="textlink" href={path('access')}>アクセス・店舗情報</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
