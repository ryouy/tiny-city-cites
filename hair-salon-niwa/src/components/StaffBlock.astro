---
import Photo from './Photo.astro';
import type { Staff } from '../data/staff';
interface Props { person: Staff; headingLevel?: 2 | 3; ratio?: string }
const { person, headingLevel = 3, ratio = '4 / 5' } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<div class="stylist__media">
  <Photo name={person.photo} {ratio} sizes="(min-width: 960px) 40vw, 100vw" label={person.role} />
</div>
<div class="stylist__text">
  <p class="stylist__badge">架空の人物（デモ）</p>
  <H>{person.name}</H>
  <p class="stylist__en">{person.en}</p>
  <p class="stylist__role">{person.role}</p>
  <dl class="stylist__dl">
    <div><dt>経験</dt><dd>{person.career}</dd></div>
    <div><dt>得意</dt><dd><ul>{person.strengths.map((s) => <li>{s}</li>)}</ul></dd></div>
  </dl>
  <blockquote>{person.message}</blockquote>
</div>
