---
interface Props { en: string; ja: string; lead?: string }
const { en, ja, lead } = Astro.props;
---

<div class="page-head">
  <div class="wrap">
    <p class="eyebrow">HAIR SALON niwa</p>
    <h1>{en}</h1>
    <p class="page-head__ja">{ja}</p>
    {lead && <p class="page-head__lead">{lead}</p>}
  </div>
</div>
