---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { photos, photoExts, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  /** ヒーローのみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。省略時は 4 / 5 */
  ratio?: string;
  sizes?: string;
  /** object-position(例: '50% 30%') */
  position?: string;
}
const { name, priority = false, ratio = '4 / 5', sizes = '(min-width: 900px) 520px, 100vw', position } = Astro.props;
const def = photos[name];
const base = import.meta.env.BASE_URL;
// ビルド時に public/images/hair-salon-niwa/ の実ファイル(webp/png/jpg/jpeg/avif)を確認。無ければプレースホルダー。
const found = photoExts.map((e) => `${def.base}.${e}`).find((f) => existsSync(join(process.cwd(), 'public', 'images', 'hair-salon-niwa', f)));
const style = `aspect-ratio:${ratio}${position ? `;object-position:${position}` : ''}`;
---

{
  found ? (
    <img
      class="photo"
      src={`${base}images/hair-salon-niwa/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={style}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`photo photo--ph tone-${def.tone}`} style={`aspect-ratio:${ratio}`} role="img" aria-label={`画像準備中。${def.shoot}`}>
      <span class="photo__tag">画像準備中</span>
    </div>
  )
}
