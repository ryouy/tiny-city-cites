---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { photos, photoExts, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  /** ヒーローのみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。省略時は 4 / 5 */
  ratio?: string;
  sizes?: string;
  /** 画像を中央拡大して使う(クローズアップ用) */
  zoom?: boolean;
  /** プレースホルダーに表示する番号など */
  label?: string;
}
const { name, priority = false, ratio = '4 / 5', sizes = '(min-width: 900px) 520px, 100vw', zoom = false, label } = Astro.props;
const def = photos[name];
const base = import.meta.env.BASE_URL;
// ビルド時に public/images/stack-burger/ の実ファイル(webp/png/jpg/jpeg/avif)を確認。無ければプレースホルダー。
const found = photoExts.map((e) => `${def.base}.${e}`).find((f) => existsSync(join(process.cwd(), 'public', 'images', 'stack-burger', f)));
---

{
  found ? (
    <img
      class={`photo${zoom ? ' photo--zoom' : ''}`}
      src={`${base}images/stack-burger/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={`aspect-ratio:${ratio}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`photo photo--ph tone-${def.tone}`} style={`aspect-ratio:${ratio}`} role="img" aria-label={`画像準備中。撮影イメージ: ${def.shoot}`}>
      <svg class="photo__stack" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <rect x="0" y="12" width="100" height="1.2" />
        <rect x="0" y="30" width="100" height="1.2" />
        <rect x="0" y="48" width="100" height="5" />
        <rect x="0" y="66" width="100" height="1.2" />
        <rect x="0" y="84" width="100" height="1.2" />
      </svg>
      <span class="photo__tag">画像準備中</span>
      {label && <span class="photo__no">{label}</span>}
      <span class="photo__shoot"><b>撮影イメージ</b>{def.shoot}</span>
    </div>
  )
}
