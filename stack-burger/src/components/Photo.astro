---
import { photos, type PhotoKey } from '../data/photos';
import { photoFile } from '../lib/photo-file';

interface Props {
  name: PhotoKey;
  /** ヒーローのみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。fill 指定時は不要 */
  ratio?: string;
  sizes?: string;
  /** 親要素いっぱいに敷く(親は position:relative で高さを持つこと) */
  fill?: boolean;
  /** object-position(被写体の位置) */
  pos?: string;
}
const { name, priority = false, ratio = '4 / 5', sizes = '100vw', fill = false, pos = '50% 50%' } = Astro.props;
const def = photos[name];
const base = import.meta.env.BASE_URL;
const found = photoFile(name);
const frame = fill ? '' : `aspect-ratio:${ratio};`;
---

{
  found ? (
    <img
      class={`photo${fill ? ' photo--fill' : ''}`}
      src={`${base}images/stack-burger/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={`${frame}object-position:${pos}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`photo photo--ph tone-${def.tone}${fill ? ' photo--fill' : ''}`} style={frame} role="img" aria-label={`${def.alt}(画像準備中)`}>
      <span class="photo__tag">画像準備中</span>
    </div>
  )
}
