---
import { site } from '../data/site';
---

<div class="top">
  <p class="demo-band"><span class="demo-band__tag">DEMO</span>{site.demoBand.replace('DEMO｜', '')}</p>
  <header class="site-header">
    <div class="wrap site-header__in">
      <a class="logo" href="#top" aria-label={`${site.name}(${site.kana}) ページの先頭へ`}>
        <span class="logo__en">STACK<span class="logo__bar" aria-hidden="true"></span>BURGER</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く">
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="nav-toggle__txt" aria-hidden="true">MENU</span>
      </button>
      <nav id="site-nav" class="site-nav" aria-label="メインメニュー">
        <ul>
          {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>
</div>
