---
import { site } from '../data/site';
---

<div class="top">
  <p class="demo-band">{site.demoBand}</p>
  <header class="site-header">
    <div class="wrap site-header__in">
      <a class="logo" href="#top" aria-label={`${site.name}(${site.kana}) ページの先頭へ`}>STACK BURGER</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="メニューを開く">MENU</button>
      <nav id="site-nav" class="site-nav" aria-label="メインメニュー">
        <ul>
          {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </header>
</div>
