---
import { categories, itemsByCategory, menuNotes, setOption, largeFries, toppings, yen } from '../data/menu';
---

<div class="menu" data-menu>
  <div class="menu__tabs" role="tablist" aria-label="メニューのカテゴリ">
    {categories.map((c, i) => (
      <button type="button" role="tab" id={`tab-${c.id}`} class="menu__tab" aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        {c.label}
      </button>
    ))}
  </div>

  {categories.map((c) => (
    <div class="menu__panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} data-panel={c.id}>
      <ul class="ptable">
        {itemsByCategory[c.id].map((it) => (
          <li class="prow">
            <div class="prow__body">
              <h3 class="prow__name">
                {it.name}
                {it.badge && <span class="prow__badge">{it.badge}</span>}
              </h3>
              {it.desc && <p class="prow__desc">{it.desc}</p>}
            </div>
            <p class="prow__price"><span class="visually-hidden">税込</span>{yen(it.price)}</p>
          </li>
        ))}
      </ul>
      {c.id === 'burgers' && <p class="menu__note">{menuNotes.badge}</p>}
    </div>
  ))}

  <div class="addons">
    <h3 class="addons__title">セット・追加</h3>
    <ul class="ptable">
      <li class="prow"><div class="prow__body"><p class="prow__name">バーガーに追加：ポテト＋対象ドリンク</p><p class="prow__desc">対象ドリンク：{setOption.drinks.join('／')}。{setOption.excluded}</p></div><p class="prow__price">＋{yen(setOption.price)}</p></li>
      <li class="prow"><div class="prow__body"><p class="prow__name">ポテト大盛り(セットのとき)</p></div><p class="prow__price">＋{yen(largeFries.price)}</p></li>
      {toppings.map((t) => <li class="prow"><div class="prow__body"><p class="prow__name">{t.label}</p></div><p class="prow__price">＋{yen(t.price)}</p></li>)}
    </ul>
    <p class="menu__note">{menuNotes.tax}</p>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p, n) => {
        p.hidden = n !== i;
      });
    };
    select(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const map: Record<string, number> = {
          ArrowRight: i === last ? 0 : i + 1,
          ArrowLeft: i === 0 ? last : i - 1,
          Home: 0,
          End: last,
        };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key], true);
        }
      });
    });
  }
</script>
