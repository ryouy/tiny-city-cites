---
import Photo from './Photo.astro';
import { categories, itemsByCategory, panelPhotos, menuNotes, setOption, largeFries, toppings, yen } from '../data/menu';
---

<div class="menu" data-menu>
  <div class="menu__tabs" role="tablist" aria-label="メニューのカテゴリ">
    {categories.map((c, i) => (
      <button type="button" role="tab" id={`tab-${c.id}`} class="menu__tab" aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="menu__tab-en">{c.label}</span>
        <span class="menu__tab-ja">{c.ja}</span>
      </button>
    ))}
  </div>

  {categories.map((c) => (
    <div class="menu__panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} data-panel={c.id}>
      <div class="menu__grid">
        <ol class="menu__list">
          {itemsByCategory[c.id].map((it, n) => (
            <li class="mi">
              <span class="mi__no" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              <div class="mi__body">
                <h3 class="mi__name">
                  {it.name}
                  {it.badge && <span class="mi__badge">{it.badge}</span>}
                </h3>
                {it.desc && <p class="mi__desc">{it.desc}</p>}
              </div>
              <p class="mi__price"><span class="visually-hidden">税込</span>{yen(it.price)}</p>
            </li>
          ))}
        </ol>
        <div class={`menu__side menu__side--${panelPhotos[c.id].length || 0}`}>
          {panelPhotos[c.id].length > 0 ? (
            panelPhotos[c.id].map((k) => (
              <figure class="menu__fig"><Photo name={k} ratio="4 / 5" sizes="(min-width: 900px) 280px, 46vw" /></figure>
            ))
          ) : (
            <div class="menu__drinkblock">
              <p class="menu__drinkblock-big" aria-hidden="true">COLD<br />DRINKS</p>
              <p class="menu__drinkblock-note">セットのドリンクは、コーラ／オレンジジュース／アイスコーヒーから選べます。</p>
            </div>
          )}
        </div>
      </div>
      {c.id === 'burgers' && (
        <p class="menu__note">{menuNotes.badge}</p>
      )}
    </div>
  ))}

  <aside class="addons" aria-label="セットと追加トッピング">
    <h3 class="addons__title">SETS <span>&amp;</span> ADD-ONS</h3>
    <ul class="addons__list">
      <li><span>バーガーに追加：ポテト＋対象ドリンク</span><b>＋{yen(setOption.price)}</b></li>
      <li><span>ポテト大盛り(セットのとき)</span><b>＋{yen(largeFries.price)}</b></li>
      {toppings.map((t) => <li><span>{t.label}</span><b>＋{yen(t.price)}</b></li>)}
    </ul>
    <p class="addons__note">セット対象ドリンク：{setOption.drinks.join('／')}。{setOption.excluded}</p>
  </aside>
  <p class="menu__foot">{menuNotes.tax}{menuNotes.fictional}</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p, n) => {
        p.hidden = n !== i;
      });
    };
    select(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const map: Record<string, number> = {
          ArrowRight: i === last ? 0 : i + 1,
          ArrowLeft: i === 0 ? last : i - 1,
          Home: 0,
          End: last,
        };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key], true);
        }
      });
    });
  }
</script>
