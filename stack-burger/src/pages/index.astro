---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Menu from '../components/Menu.astro';
import Builder from '../components/Builder.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site } from '../data/site';
import { photoFile } from '../lib/photo-file';

// メニュー下の写真列は、3枚そろったときだけ表示(未配置のときは枠を出さない)
const menuPhotos = [
  { key: 'classic', label: 'クラシック・スマッシュ' },
  { key: 'bacon', label: 'スモーキーベーコン' },
  { key: 'fries', label: 'フライドポテト' },
] as const;
const showMenuPhotos = menuPhotos.every((p) => photoFile(p.key));
---

<BaseLayout>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">STACK BURGER</h1>
      <p class="hero__lead">{site.hero.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={site.hero.cta1.href}>{site.hero.cta1.label}</a>
        <a class="btn btn--line" href={site.hero.cta2.href}>{site.hero.cta2.label}</a>
      </div>
    </div>
    <div class="hero__fig">
      <Photo name="hero" fill priority pos="50% 50%" sizes="(min-width: 900px) 46vw, 100vw" />
    </div>
  </section>

  <section class="sig" id="signature" aria-labelledby="sig-title">
    <div class="sig__fig">
      <Photo name="signature" fill pos="50% 55%" sizes="(min-width: 900px) 50vw, 100vw" />
    </div>
    <div class="sig__text">
      <h2 id="sig-title">{site.signature.h2}</h2>
      <p class="sig__price">{site.signature.price}</p>
      <p>{site.signature.body}</p>
    </div>
  </section>

  <section class="menu-sec" id="menu" aria-labelledby="menu-title">
    <div class="wrap menu-sec__in">
      <h2 id="menu-title" class="menu-sec__h">メニュー</h2>
      <div class="menu-sec__body">
        <Menu />
      </div>
    </div>
    {showMenuPhotos && (
      <div class="wrap">
        <div class="menu-photos">
          {menuPhotos.map((p) => (
            <figure>
              <Photo name={p.key} ratio="4 / 5" sizes="(min-width: 900px) 360px, 50vw" />
              <figcaption>{p.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}
  </section>

  <section class="build" id="build" aria-labelledby="build-title">
    <div class="wrap">
      <div class="build__head">
        <h2 id="build-title">金額の計算</h2>
        <p>金額の参考計算です。注文はできません。</p>
      </div>
      <Builder />
    </div>
  </section>

  <section class="style" id="our-style" aria-labelledby="style-title">
    <figure class="style__fig"><Photo name="griddle" ratio="3 / 2" pos="50% 40%" sizes="100vw" /></figure>
    <div class="wrap style__in">
      <h2 id="style-title">{site.ourStyle.h2}</h2>
      <ul class="style__steps">
        {site.ourStyle.steps.map((s) => (
          <li><b>{s.title}</b><span>{s.body}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="wrap about__in">
      <h2 id="about-title">{site.about.h2}</h2>
      <div class="about__text">
        <p>{site.about.concept}</p>
        <p>{site.about.story}</p>
      </div>
    </div>
    <figure class="about__fig"><Photo name="interior" ratio="16 / 9" pos="50% 60%" sizes="100vw" /></figure>
  </section>

  <section class="info" id="info" aria-labelledby="info-title">
    <div class="wrap">
      <h2 id="info-title">店舗案内</h2>
      <div class="info__grid">
        <dl class="info__dl">
          {site.info.map((r) => (
            <div class="info__row"><dt>{r.dt}</dt><dd>{r.dd}</dd></div>
          ))}
          <div class="info__row"><dt>所在地</dt><dd>{site.location}</dd></div>
        </dl>
        <div class="info__side">
          <div class="notice">
            <h3 class="notice__title">{site.noticeTitle}</h3>
            <p>{site.noticeBody}</p>
          </div>
          <MapEmbed />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
