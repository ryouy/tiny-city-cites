---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Menu from '../components/Menu.astro';
import Builder from '../components/Builder.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { site } from '../data/site';
import { photoFile } from '../lib/photo-file';

// メニュー下の写真列は、4枚そろったときだけ表示(未配置のときは枠を出さない)
const menuPhotos = (['double', 'classic', 'bacon', 'fries'] as const);
const showMenuPhotos = menuPhotos.every((k) => photoFile(k));
---

<BaseLayout>
  <section class="poster poster--hero" id="top" aria-labelledby="hero-title">
    <Photo name="hero" fill priority pos="50% 55%" sizes="100vw" />
    <div class="wrap poster__in">
      <h1 id="hero-title" class="hero__title"><span class="nw">かぶりつけ、</span><span class="nw">うまさを重ねろ。</span></h1>
      <p class="hero__lead">{site.hero.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--solid" href={site.hero.cta1.href}>{site.hero.cta1.label}</a>
        <a class="btn btn--line-light" href={site.hero.cta2.href}>{site.hero.cta2.label}</a>
      </div>
    </div>
  </section>

  <section class="poster poster--sig" id="signature" aria-labelledby="sig-title">
    <Photo name="signature" fill pos="50% 45%" sizes="100vw" />
    <div class="wrap poster__in">
      <div class="sig reveal">
        <p class="sig__price">{site.signature.price}</p>
        <h2 id="sig-title" class="sig__h2"><span class="nw">迷ったら、</span><span class="nw">ダブルで。</span></h2>
        <p class="sig__name">{site.signature.name}</p>
        <p>{site.signature.body}</p>
        <p class="note">{site.signature.note}</p>
      </div>
    </div>
  </section>

  <section class="menu-sec" id="menu" aria-labelledby="menu-title">
    <div class="wrap menu-sec__in">
      <h2 id="menu-title" class="menu-sec__h">MENU</h2>
      <div class="menu-sec__body">
        <Menu />
      </div>
    </div>
    {showMenuPhotos && (
      <div class="wrap">
        <div class="menu-photos">
          {menuPhotos.map((k) => <figure><Photo name={k} ratio="4 / 5" sizes="(min-width: 900px) 300px, 50vw" /></figure>)}
        </div>
      </div>
    )}
  </section>

  <section class="build" id="build" aria-labelledby="build-title">
    <div class="wrap">
      <div class="build__head">
        <h2 id="build-title">Build Your Stack</h2>
        <p>金額の参考計算です。注文はできません。</p>
      </div>
      <Builder />
    </div>
  </section>

  <section class="poster poster--style" id="our-style" aria-labelledby="style-title">
    <Photo name="griddle" fill pos="50% 50%" sizes="100vw" />
    <div class="wrap poster__in">
      <div class="style reveal">
        <h2 id="style-title" class="style__h2">{site.ourStyle.h2}</h2>
        <p class="style__body">{site.ourStyle.body}</p>
        <ul class="style__steps">
          {site.ourStyle.steps.map((s) => (
            <li><b>{s.title}</b><span>{s.body}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="about" id="about" aria-labelledby="about-title">
    <figure class="about__fig"><Photo name="interior" ratio="16 / 9" sizes="100vw" /></figure>
    <div class="wrap about__in">
      <h2 id="about-title" class="about__h2">{site.about.h2}</h2>
      <div class="about__text">
        <p>{site.about.concept}</p>
        <p>{site.about.story}</p>
      </div>
    </div>
  </section>

  <section class="take" id="takeout" aria-labelledby="take-title">
    <div class="wrap take__in">
      <h2 id="take-title" class="take__h2"><span class="nw">好きな場所で、</span><span class="nw">思いきり。</span></h2>
      <div class="take__text">
        <p>{site.takeout.body}</p>
        <p class="take__note">{site.takeout.note}</p>
      </div>
    </div>
  </section>

  <section class="info" id="info" aria-labelledby="info-title">
    <div class="wrap">
      <h2 id="info-title" class="info__h2"><span class="nw">今日のごはんは、</span><span class="nw">バーガーにしよう。</span></h2>
      <p class="info__lead">{site.visit.body}</p>
      <div class="info__grid">
        <dl class="info__dl">
          {site.info.map((r) => (
            <div class="info__row"><dt>{r.dt}</dt><dd>{r.dd}</dd></div>
          ))}
          <div class="info__row"><dt>所在地</dt><dd>{site.location}</dd></div>
        </dl>
        <div class="info__side">
          <div class="notice">
            <h3 class="notice__title">{site.noticeTitle}</h3>
            <p>{site.noticeBody}</p>
          </div>
          <MapEmbed />
          <p class="info__nocontact">{site.noContact}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
