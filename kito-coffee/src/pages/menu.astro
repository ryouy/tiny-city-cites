---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import MenuList from '../components/MenuList.astro';
import { photos } from '../data/photos';
import { menu, menuNotes } from '../data/menu';
---

<BaseLayout
  current="menu"
  title="メニュー | KITO COFFEE"
  description="KITO COFFEEのメニュー。コーヒー、ドリンク、お菓子の全品を税込価格で載せています。"
>
  <div class="container page menu-page">
    <h1 class="h1">メニュー</h1>
    <p class="note">{menuNotes.tax}</p>
    <div class="menu-page__grid">
      <div class="menu-page__body">
        {menu.map((cat) => <MenuList cat={cat} />)}
        <p class="menu-notes">{menuNotes.set}</p>
      </div>
      <div class="menu-page__photo">
        <Photo photo={photos.blend} ratio="1 / 1" ratioSm="16 / 9" pos="50% 48%" sizes="(min-width: 900px) 30vw, 100vw" />
      </div>
    </div>
  </div>
</BaseLayout>
