---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { photos } from '../data/photos';
import { site } from '../data/site';
---

<BaseLayout
  current="information"
  title="店舗情報 | KITO COFFEE"
  description="KITO COFFEEの営業時間、休業日、座席、駐車場、持ち帰り、支払い方法と地図。"
>
  <div class="container page info-page">
    <div class="info-page__main">
      <h1 class="h1">店舗情報</h1>
      <dl class="info-list">
        {
          site.info.map((row) => (
            <div class="info-list__row">
              <dt>{row.term}</dt>
              <dd>{row.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="info-page__map">
      <MapEmbed />
    </div>
  </div>

  <section class="gallery container" aria-labelledby="gallery-title">
    <h2 id="gallery-title" class="h2">写真</h2>
    <div class="gallery__grid">
      <div class="gallery__a"><Photo photo={photos.hero} ratio="2 / 1" ratioSm="3 / 2" pos="50% 62%" sizes="100vw" /></div>
      <div class="gallery__b"><Photo photo={photos.blend} ratio="1 / 1" pos="50% 48%" sizes="(min-width: 900px) 32vw, 50vw" /></div>
      <div class="gallery__c"><Photo photo={photos.interior} ratio="1 / 1" pos="40% 45%" sizes="(min-width: 900px) 32vw, 50vw" /></div>
      <div class="gallery__d"><Photo photo={photos.pourOver} ratio="1 / 1" ratioSm="3 / 2" pos="52% 50%" sizes="(min-width: 900px) 32vw, 100vw" /></div>
    </div>
  </section>
</BaseLayout>
