---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import MenuList from '../components/MenuList.astro';
import { photos } from '../data/photos';
import { menu, menuNotes } from '../data/menu';
import { site, url } from '../data/site';

const drinks = menu.find((c) => c.id === 'coffee')!;
const sweets = menu.find((c) => c.id === 'sweets')!;
const hours = site.info.filter((r) => ['営業時間', '休業日', '座席'].includes(r.term));
---

<BaseLayout current="home">
  <div class="hero-photo">
    <Photo photo={photos.hero} ratio="21 / 9" ratioSm="4 / 3" eager pos="58% 55%" sizes="100vw" />
  </div>

  <div class="container top">
    <h1 class="h1">KITO COFFEE</h1>
    <p>会津若松市のコーヒー店です。ハンドドリップのコーヒーと、手づくりのお菓子を出しています。</p>
    <dl class="info-list">
      {
        hours.map((row) => (
          <div class="info-list__row">
            <dt>{row.term}</dt>
            <dd>{row.desc}</dd>
          </div>
        ))
      }
    </dl>
    <p class="more"><a href={url('information/')}>店舗情報</a></p>
  </div>

  <section class="container excerpt" aria-labelledby="excerpt-title">
    <h2 id="excerpt-title" class="h2">メニューの一部</h2>
    <p class="note">{menuNotes.tax}</p>
    <div class="excerpt__lists">
      <MenuList cat={drinks} onlyFeatured level={3} />
      <MenuList cat={sweets} onlyFeatured level={3} />
    </div>
    <p class="more"><a href={url('menu/')}>メニュー全体</a></p>
  </section>
</BaseLayout>
