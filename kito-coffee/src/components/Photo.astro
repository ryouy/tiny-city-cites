---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { imageDir, type PhotoDef } from '../data/photos';
import { url } from '../data/site';

interface Props {
  photo: PhotoDef;
  /** CSS aspect-ratio 形式 例: "4 / 5" */
  ratio?: string;
  /** モバイル(〜767px)での比率 */
  ratioSm?: string;
  eager?: boolean;
  /** true なら親要素いっぱいに広げる(ヒーロー用) */
  fill?: boolean;
  sizes?: string;
  class?: string;
  /** 切り抜きの基準位置 (object-position) */
  pos?: string;
}
const {
  photo,
  ratio = '4 / 3',
  ratioSm,
  eager = false,
  fill = false,
  sizes = '100vw',
  class: className = '',
  pos,
} = Astro.props;

// ビルド時に実ファイルの有無を判定する
const exists = existsSync(join(process.cwd(), 'public', imageDir, photo.file));
const style = `--r:${ratio};--r-sm:${ratioSm ?? ratio}${pos ? `;--pos:${pos}` : ''}`;
const cls = ['photo', `tone-${photo.tone}`, fill ? 'photo--fill' : '', className].filter(Boolean).join(' ');
---

{
  exists ? (
    <div class={cls} style={style}>
      <img
        src={url(`${imageDir.slice(1)}${photo.file}`)}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding={eager ? 'sync' : 'async'}
      />
    </div>
  ) : (
    <div class={`${cls} photo--placeholder`} style={style} role="img" aria-label={`画像準備中：${photo.alt}`}>
      <span class="photo__status" aria-hidden="true">画像準備中</span>
    </div>
  )
}
