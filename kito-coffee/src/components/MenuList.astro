---
import { formatPrice, type MenuCategory } from '../data/menu';

interface Props {
  cat: MenuCategory;
  /** true ならおすすめ(featured)だけ表示 */
  onlyFeatured?: boolean;
  level?: 2 | 3;
}
const { cat, onlyFeatured = false, level = 2 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const items = onlyFeatured ? cat.items.filter((i) => i.featured) : cat.items;
---

<section class="menu-cat" aria-labelledby={`menu-${cat.id}`}>
  <Heading class="menu-cat__title" id={`menu-${cat.id}`}>{cat.title}</Heading>
  <ul>
    {
      items.map((item) => (
        <li class="menu-item">
          <div class="menu-item__row">
            <span class="menu-item__name">{item.name}</span>
            <span class="menu-item__price">
              <span class="visually-hidden">税込 </span>
              {formatPrice(item.price)}
              {item.priceSuffix}
            </span>
          </div>
          {item.description && <p class="menu-item__desc">{item.description}</p>}
        </li>
      ))
    }
  </ul>
</section>
