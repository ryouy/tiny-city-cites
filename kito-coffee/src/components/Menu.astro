---
import { menu, menuNotes, formatPrice } from '../data/menu';
---

<section class="section menu" id="menu" aria-labelledby="menu-title">
  <div class="container menu__grid">
    <header class="menu__head reveal">
      <p class="eyebrow">Menu</p>
      <h2 id="menu-title" class="h2">メニュー</h2>
      <p class="menu__tax">{menuNotes.tax}</p>
    </header>
    <div class="menu__body">
      {
        menu.map((cat) => (
          <section class="menu-cat reveal" aria-labelledby={`menu-${cat.id}`}>
            <h3 class="menu-cat__title" id={`menu-${cat.id}`}>
              <span class="menu-cat__en">{cat.title}</span>
              <span class="menu-cat__ja">{cat.ja}</span>
            </h3>
            <ul class="menu-list">
              {cat.items.map((item) => (
                <li class="menu-item">
                  <div class="menu-item__row">
                    <span class="menu-item__name">{item.name}</span>
                    <span class="menu-item__leader" aria-hidden="true" />
                    <span class="menu-item__price">
                      <span class="visually-hidden">税込 </span>
                      {formatPrice(item.price)}
                      {item.priceSuffix}
                    </span>
                  </div>
                  {item.description && <p class="menu-item__desc">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <div class="menu-notes reveal">
        <p class="menu-notes__set">{menuNotes.set}</p>
        <p class="menu-notes__small">{menuNotes.fiction}</p>
      </div>
    </div>
  </div>
</section>
