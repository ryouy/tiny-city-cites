---
import Photo from './Photo.astro';
import { photos } from '../data/photos';

// 大小差のある配置。grid-area は global.css の .gallery__item--* で定義
const items = [
  { photo: photos.interior, pos: 'a', ratio: '3 / 4', ratioSm: '4 / 5', sizes: '(min-width: 900px) 40vw, 100vw' },
  { photo: photos.blend, pos: 'b', ratio: '1 / 1', ratioSm: '1 / 1', sizes: '(min-width: 900px) 24vw, 50vw' },
  { photo: photos.sweets, pos: 'c', ratio: '4 / 3', ratioSm: '1 / 1', sizes: '(min-width: 900px) 30vw, 50vw' },
  { photo: photos.pourOver, pos: 'd', ratio: '16 / 9', ratioSm: '4 / 3', sizes: '(min-width: 900px) 50vw, 100vw' },
];
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">Gallery</p>
      <h2 id="gallery-title" class="h2">KITOの時間</h2>
    </header>
    <div class="gallery__grid">
      {
        items.map((it) => (
          <div class={`gallery__item gallery__item--${it.pos} reveal`}>
            <Photo photo={it.photo} ratio={it.ratio} ratioSm={it.ratioSm} sizes={it.sizes} showCaption={false} />
          </div>
        ))
      }
    </div>
  </div>
</section>
