---
import { site, url, type PageKey } from '../data/site';

interface Props {
  current: PageKey;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href={url()} aria-current={current === 'home' ? 'page' : undefined}>{site.name}</a>
    <nav class="site-nav" aria-label="メインナビゲーション">
      <ul>
        {
          site.nav.map((l) => (
            <li>
              <a href={url(l.path)} aria-current={current === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
