---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { photos, photoExts } from '../data/photos';
import type { PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  /** ヒーローのみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。文脈ごとに CSS 側で上書きしてもよい */
  ratio?: string;
  sizes?: string;
  /** object-position(被写体の位置に合わせて指定) */
  pos?: string;
}
const { name, priority = false, ratio = '4 / 5', sizes = '(min-width: 900px) 50vw, 100vw', pos = '50% 50%' } = Astro.props;
const def = photos[name];
// ビルド時に public/images/trattoria-machi/ の実ファイル(webp/png/jpg/jpeg/avif)を確認。無ければ控えめなプレースホルダー。
const found = photoExts
  .map((e) => `${def.base}.${e}`)
  .find((f) => existsSync(join(process.cwd(), 'public', 'images', 'trattoria-machi', f)));
---

{
  found ? (
    <img
      class="photo"
      src={`${import.meta.env.BASE_URL}images/trattoria-machi/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={`--r:${ratio};--pos:${pos}`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`photo photo--ph tone-${def.tone}`} style={`--r:${ratio}`} role="img" aria-label={`${def.alt}（画像準備中。${def.shoot}）`}>
      <span class="photo__tag">画像準備中</span>
    </div>
  )
}
