---
import { tabs, lunch, lunchDrinks, pasta, pastaNote, pizza, pizzaNote, antipasti, dolce, drink, wineNote } from '../data/menu';
import type { Item } from '../data/menu';
import { hours } from '../data/site';

const lists: Record<string, { head?: string; items: Item[] }[]> = {
  lunch: [{ items: lunch }],
  pasta: [{ items: pasta }],
  pizza: [{ items: pizza }],
  antipasti: [{ items: antipasti }],
  dolce: [{ head: 'Dolce', items: dolce }, { head: 'Drink', items: drink }],
};
const notes: Record<string, string[]> = {
  lunch: [`ランチ提供 ${hours.lunchServe}。ドリンクは ${lunchDrinks} からお選びいただけます。`],
  pasta: [pastaNote],
  pizza: [pizzaNote],
  antipasti: [],
  dolce: [wineNote],
};
---

<div class="mtabs" data-tabs>
  <div class="mtabs__list" role="tablist" aria-label="メニューのカテゴリ">
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`tab-${t.key}`} aria-controls={`panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
    ))}
  </div>
  <p class="mtabs__tax">価格はすべて税込表記です。</p>
  {tabs.map((t, i) => (
    <div class="mtabs__panel" role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} tabindex="0" data-hidden-js={i === 0 ? undefined : ''}>
      <h3 class="visually-hidden">{t.label}</h3>
      {lists[t.key].map((g) => (
        <>
          {g.head && <h4 class="mtabs__sub">{g.head}</h4>}
          <ul class="mlist">
            {g.items.map((it) => (
              <li>
                <span class="mlist__name">{it.name}</span>
                <span class="mlist__dots" aria-hidden="true"></span>
                <span class="mlist__price">{it.price}</span>
                {it.desc && <span class="mlist__desc">{it.desc}</span>}
              </li>
            ))}
          </ul>
        </>
      ))}
      {notes[t.key].map((n) => <p class="mtabs__note">{n}</p>)}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => p.toggleAttribute('data-hidden-js', i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); select((i + 1) % n, true); }
        else if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); select((i - 1 + n) % n, true); }
        else if (k === 'Home') { e.preventDefault(); select(0, true); }
        else if (k === 'End') { e.preventDefault(); select(n - 1, true); }
      });
    });
  });
</script>
