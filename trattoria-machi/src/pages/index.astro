---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { hero, hoursBand, sections, info } from '../data/site';
const base = import.meta.env.BASE_URL;
const menu = `${base}menu/`;
---

<BaseLayout current="top">
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <Photo name="hero" priority ratio="16 / 9" sizes="100vw" />
      <div class="wrap hero__body">
        <h1 id="hero-title">{hero.h1}</h1>
        <table class="hours">
          <thead>
            <tr><th scope="col">時間帯</th><th scope="col">営業時間</th><th scope="col">予算</th></tr>
          </thead>
          <tbody>
            {hoursBand.map((h) => (
              <tr>
                <th scope="row">{h.k}</th>
                <td class="hours__time">{h.time}</td>
                <td class="hours__budget">{h.budget}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="hero__links">
          <a href={`${menu}#lunch`}>ランチメニューを見る</a>
          <a href={`${menu}#pasta`}>ディナーメニューを見る</a>
          <a href="#info">店舗案内</a>
        </p>
        <p class="hero__closed">定休日 月曜日</p>
      </div>
    </section>

    <section id="about" class="about wrap" aria-labelledby="about-title">
      <div class="about__photo"><Photo name="interior" ratio="3 / 2" sizes="(min-width: 900px) 480px, 100vw" /></div>
      <div class="about__text">
        <h2 id="about-title">{sections.story.h2}</h2>
        {sections.story.paras.map((t) => <p>{t}</p>)}
      </div>
    </section>

    <section id="info" class="info wrap" aria-labelledby="info-title">
      <h2 id="info-title">店舗案内</h2>
      <div class="info__grid">
        <dl class="info__list">
          {info.map((r) => (
            <div>
              <dt>{r.dt}</dt>
              <dd>{r.dd.map((d) => <span>{d}</span>)}</dd>
            </div>
          ))}
        </dl>
        <div class="info__access">
          <MapEmbed />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
