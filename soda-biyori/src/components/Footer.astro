---
import { site, pages, url } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <p class="site-footer__name">{site.name}</p>
    <ul class="site-footer__nav">
      <li><a href={url()}>トップ</a></li>
      {pages.map((p) => <li><a href={url(p.path)}>{p.label}</a></li>)}
    </ul>
    <p class="site-footer__disc">{site.disclaimer}</p>
  </div>
</footer>
