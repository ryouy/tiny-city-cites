---
import Photo from './Photo.astro';
import { sweets, foods } from '../data/menu';
const pudding = sweets[0];
const food3 = foods.slice(0, 3);
---

<section class="section pudding" aria-labelledby="pudding-title">
  <div class="container pudding__grid">
    <div class="pudding__photo reveal">
      <Photo name="pudding" ratio="5 / 4" label="No.03" sizes="(min-width: 900px) 600px, 90vw" />
    </div>
    <div class="pudding__copy reveal">
      <p class="eyebrow">Kissa Sweets</p>
      <h2 id="pudding-title" class="h2">
        <span class="nw">プリンは、</span><span class="nw">ちょっぴり</span><span class="nw">固めがいい。</span>
      </h2>
      <p>スプーンを入れると、むっちりとした食感。ほろ苦いカラメルと、優しい卵の風味。懐かしい味を、ゆっくりどうぞ。</p>
      <p class="feature-line">
        <span class="feature-line__name">{pudding.name}</span>
        <span class="feature-line__price serif">{pudding.price}</span>
        <span class="feature-line__desc">{pudding.desc}</span>
      </p>
    </div>
  </div>
</section>

<section class="section food" aria-labelledby="food-title">
  <div class="container food__grid">
    <div class="food__copy reveal">
      <p class="eyebrow">Kissa Food</p>
      <h2 id="food-title" class="h2">
        <span class="nw">おなかがすいたら、</span><span class="nw">喫茶ごはん。</span>
      </h2>
      <p>鉄板ナポリタンにオムライス、厚焼きたまごサンド。見た目も味も、あの頃のわくわくを。</p>
      <ul class="feature-list">
        {
          food3.map((f) => (
            <li>
              <span class="feature-line__name">{f.name}</span>
              <span class="feature-line__price serif">{f.price}</span>
              <span class="feature-line__desc">{f.desc}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="food__photos reveal">
      <div class="food__a"><Photo name="napolitan" ratio="5 / 4" label="No.04" sizes="(min-width: 900px) 560px, 90vw" /></div>
      <div class="food__b"><Photo name="omelette" ratio="1 / 1" label="No.05" sizes="(min-width: 900px) 300px, 60vw" /></div>
    </div>
  </div>
</section>
