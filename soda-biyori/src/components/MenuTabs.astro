---
import { sodas, sweets, foods, drinks, setNote, menuDisclaimer, menuTaxNote } from '../data/menu';

const tabs = [
  { id: 'soda', label: 'クリームソーダ', en: 'Cream Soda', items: sodas.map((s) => ({ name: s.name, price: s.price, desc: s.notes.join('／'), badge: s.badge })) },
  { id: 'sweets', label: 'スイーツ', en: 'Kissa Sweets', items: sweets.map((s) => ({ name: s.name, price: s.price, desc: s.desc, badge: undefined as string | undefined })) },
  { id: 'food', label: 'フード', en: 'Kissa Food', items: foods.map((s) => ({ name: s.name, price: s.price, desc: s.desc, badge: undefined as string | undefined })) },
  { id: 'drink', label: 'ドリンク', en: 'Coffee & Tea', items: drinks.map((d) => ({ name: d.name, price: d.price, desc: '', badge: undefined as string | undefined })) },
];
---

<section class="section tabs" id="full-menu" aria-labelledby="tabs-title">
  <div class="container">
    <header class="tabs__head reveal">
      <p class="eyebrow">Food &amp; Sweets</p>
      <h2 id="tabs-title" class="h2"><span class="nw">メニュー</span><span class="nw">いろいろ</span></h2>
      <p class="tabs__note">{menuTaxNote}{menuDisclaimer}</p>
    </header>

    <div class="tablist" role="tablist" aria-label="メニューのカテゴリ">
      {
        tabs.map((t, i) => (
          <button class="tab" role="tab" type="button" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="tab__ja">{t.label}</span>
            <span class="tab__en" aria-hidden="true">{t.en}</span>
          </button>
        ))
      }
    </div>

    {
      tabs.map((t, i) => (
        <div class="tabpanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0" data-open={i === 0 ? 'true' : undefined}>
          <h3 class="visually-hidden">{t.label}</h3>
          <ul class="menu-list">
            {
              t.items.map((it) => (
                <li class="menu-row">
                  <span class="menu-row__head">
                    <span class="menu-row__name">{it.name}</span>
                    {it.badge && <span class="badge badge--sm">{it.badge}</span>}
                    <span class="menu-row__leader" aria-hidden="true" />
                    <span class="menu-row__price serif">{it.price}</span>
                  </span>
                  {it.desc && <span class="menu-row__desc">{it.desc}</span>}
                </li>
              ))
            }
          </ul>
          {t.id === 'drink' && <p class="tabs__set">セット：{setNote}</p>}
        </div>
      ))
    }
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tablist .tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.tabpanel'));
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      t.setAttribute('aria-selected', String(i === j));
      t.tabIndex = i === j ? 0 : -1;
    });
    panels.forEach((p, j) => (p.hidden = i !== j));
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      const n = tabs.length;
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % n;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + n) % n;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = n - 1;
      if (next >= 0) {
        e.preventDefault();
        select(next, true);
      }
    });
  });
  select(0);
</script>
