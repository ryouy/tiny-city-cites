---
import { sodas } from '../data/menu';
const s = sodas[4];
const seasons = ['春', '夏', '秋', '冬'];
---

<section class="section seasonal" aria-labelledby="season-title">
  <div class="container seasonal__grid">
    <div class="seasonal__copy reveal">
      <p class="eyebrow">Seasonal</p>
      <h2 id="season-title" class="h2"><span class="nw">季節のおすすめ</span></h2>
      <p class="seasonal__flag"><b>サンプル情報</b>実際の日付や時期に応じた自動切り替えは行いません。</p>
      <p class="seasonal__name">{s.name}</p>
      <p class="seasonal__price"><span class="serif">{s.price}</span><small>（税込）</small><span class="badge">{s.badge}</span></p>
      <p>{s.notes.join('／')}。</p>
    </div>
    <ul class="seasonal__swatches reveal" aria-label="季節ごとに変わる色のイメージ（サンプル）">
      {seasons.map((n) => <li class={`swatch swatch--${n}`}><span>{n}</span></li>)}
    </ul>
  </div>
</section>
