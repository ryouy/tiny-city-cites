---
import { news } from '../data/site';
---

<section class="section news" aria-labelledby="news-title">
  <div class="container news__grid">
    <h2 id="news-title" class="h2">お知らせ</h2>
    <ul class="news__list reveal">
      {
        news.map((n) => (
          <li class="news__item">
            <h3 class="news__title">{n.title}</h3>
            <p>{n.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
