---
import { news } from '../data/site';
---

<section class="section news" id="news" aria-labelledby="news-title">
  <div class="container news__grid">
    <header class="reveal">
      <p class="eyebrow">News</p>
      <h2 id="news-title" class="h2"><span class="nw">お知らせ</span></h2>
      <p class="news__note">すべて架空のサンプルです。</p>
    </header>
    <ol class="news__list">
      {
        news.map((n) => (
          <li class="news__item reveal">
            <span class="news__no serif" aria-hidden="true">{n.no}</span>
            <h3 class="news__title">{n.title}</h3>
            <p>{n.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
