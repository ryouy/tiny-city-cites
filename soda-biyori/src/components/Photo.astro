---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { photos, photoExts } from '../data/photos';
import type { PhotoKey } from '../data/menu';

interface Props {
  name: PhotoKey;
  /** ヒーローのみ true(eager + fetchpriority=high) */
  priority?: boolean;
  /** 枠のアスペクト比(CSS値)。省略時は 4 / 5 */
  ratio?: string;
  sizes?: string;
  /** object-position(例: '50% 30%') */
  pos?: string;
}
const { name, priority = false, ratio = '4 / 5', sizes = '(min-width: 900px) 520px, 100vw', pos } = Astro.props;
const def = photos[name];
// ビルド時に public/images/soda-biyori/ の実ファイル(webp/png/jpg/jpeg/avif)を確認。無ければ単色面。
const found = photoExts.map((e) => `${def.base}.${e}`).find((f) => existsSync(join(process.cwd(), 'public', 'images', 'soda-biyori', f)));
const style = `aspect-ratio:${ratio}${pos ? `;object-position:${pos}` : ''}`;
---

{
  found ? (
    <img
      class="photo"
      src={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}images/soda-biyori/${found}`}
      alt={def.alt}
      width={def.width}
      height={def.height}
      sizes={sizes}
      style={style}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`photo photo--ph tone-${def.tone}`} style={style} role="img" aria-label={`画像準備中：${def.alt}`}>
      <span class="photo__tag">画像準備中</span>
    </div>
  )
}
