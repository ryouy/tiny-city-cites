---
import { pages, url, type PageKey } from '../data/site';
interface Props { current: PageKey }
const { current } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url()} aria-current={current === 'home' ? 'page' : undefined}>喫茶 ソーダ日和</a>
    <nav class="site-nav" aria-label="メインナビゲーション">
      <ul>
        {pages.map((p) => <li><a href={url(p.path)} aria-current={current === p.key ? 'page' : undefined}>{p.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
