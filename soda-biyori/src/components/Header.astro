---
import { site, pages, url, type PageKey } from '../data/site';
interface Props { current: PageKey }
const { current } = Astro.props;
---

<p class="demo-band">{site.bandNote}<span class="demo-band__more">｜実在の店舗ではありません</span></p>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url()} aria-current={current === 'home' ? 'page' : undefined}>
      <span class="brand__en">SODA BIYORI</span>
      <span class="brand__ja">喫茶 ソーダ日和</span>
    </a>
    <nav class="site-nav" aria-label="メインナビゲーション">
      <ul>
        {pages.map((p) => <li><a href={url(p.path)} aria-current={current === p.key ? 'page' : undefined}>{p.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
