---
import Photo from './Photo.astro';
import { url } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title"><span class="hero__kind">喫茶</span> <span class="hero__name">ソーダ日和</span></h1>
      <p class="hero__lead">クリームソーダ、固めプリン、鉄板ナポリタン。</p>
      <p class="hero__cta">
        <a class="btn btn--solid" href={url('menu/')}>メニューを見る</a>
        <a class="btn" href={url('shop/')}>お店について</a>
      </p>
      <p class="hero__hours">11:00–19:00／月曜定休</p>
    </div>
    <div class="hero__visual">
      <Photo name="hero" priority ratio="4 / 5" pos="50% 40%" sizes="(min-width: 900px) 440px, 90vw" />
    </div>
  </div>
</section>
