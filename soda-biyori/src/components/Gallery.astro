---
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/menu';
const shots: { k: PhotoKey; pos?: string; wide?: boolean }[] = [
  { k: 'interior', pos: '50% 45%', wide: true },
  { k: 'pudding', pos: '55% 50%' },
  { k: 'ichigo', pos: '50% 42%' },
  { k: 'napolitan', pos: '60% 55%' },
  { k: 'aozora', pos: '50% 42%' },
  { k: 'omelette', pos: '55% 55%' },
  { k: 'yuyake', pos: '50% 42%' },
];
---

<section class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title" class="h2">ギャラリー</h2>
    <div class="snaps">
      {shots.map((s) => <figure class={s.wide ? 'snap snap--wide' : 'snap'}><Photo name={s.k} ratio={s.wide ? '2 / 1' : '1 / 1'} pos={s.pos} sizes={s.wide ? '(min-width: 900px) 560px, 92vw' : '(min-width: 900px) 270px, 46vw'} /></figure>)}
    </div>
  </div>
</section>
