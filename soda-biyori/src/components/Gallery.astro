---
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/menu';
// スナップ風グリッド。span は 12 カラム中の幅、r は回転(deg)。
const shots: { k: PhotoKey; ratio: string; cls: string }[] = [
  { k: 'interior', ratio: '4 / 3', cls: 'g1' },
  { k: 'ichigo', ratio: '4 / 5', cls: 'g2' },
  { k: 'pudding', ratio: '1 / 1', cls: 'g3' },
  { k: 'aozora', ratio: '4 / 5', cls: 'g4' },
  { k: 'napolitan', ratio: '4 / 3', cls: 'g5' },
  { k: 'yuyake', ratio: '4 / 5', cls: 'g6' },
  { k: 'omelette', ratio: '1 / 1', cls: 'g7' },
  { k: 'hero', ratio: '4 / 5', cls: 'g8' },
];
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <header class="reveal">
      <p class="eyebrow">Gallery</p>
      <h2 id="gallery-title" class="h2"><span class="nw">店内と、</span><span class="nw">お皿のスナップ。</span></h2>
    </header>
    <div class="snaps">
      {
        shots.map((s, i) => (
          <figure class={`snap ${s.cls}`}>
            <Photo name={s.k} ratio={s.ratio} sizes="(min-width: 900px) 340px, 46vw" label={`No.${String(i + 1).padStart(2, '0')}`} />
          </figure>
        ))
      }
    </div>
  </div>
</section>
