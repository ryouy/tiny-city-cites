---
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/menu';
// スマホは写真の縦横比のまま並べ、PC は 上段=縦長 4:5 / 下段=横長 5:4 に揃える(正方形のオムライスのみ 5:4 に切り出し)。
const shots: { k: PhotoKey; ratio: string; sq?: boolean }[] = [
  { k: 'ichigo', ratio: '1122 / 1402' },
  { k: 'aozora', ratio: '1122 / 1402' },
  { k: 'yuyake', ratio: '1122 / 1402' },
  { k: 'pudding', ratio: '1402 / 1122' },
  { k: 'napolitan', ratio: '1402 / 1122' },
  { k: 'omelette', ratio: '1 / 1', sq: true },
];
---

<section class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title" class="h2">ギャラリー</h2>
    <div class="snaps">
      {shots.map((s) => <figure class={`snap snap--${s.sq ? 'sq' : s.ratio.startsWith('1122') ? 'tall' : 'wide'}`}><Photo name={s.k} ratio={s.ratio} sizes="(min-width: 900px) 360px, 46vw" /></figure>)}
    </div>
  </div>
</section>
