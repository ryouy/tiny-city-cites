---
import Photo from './Photo.astro';
import { facts, ownerStory } from '../data/site';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__photo reveal">
      <Photo name="interior" ratio="4 / 5" label="No.02" sizes="(min-width: 900px) 480px, 90vw" />
      <p class="sticker sticker--about" aria-hidden="true"><span>since</span><b>2025</b><span>架空設定</span></p>
    </div>
    <div class="about__copy reveal">
      <p class="eyebrow">Our Story</p>
      <h2 id="about-title" class="h2">
        <span class="nw">懐かしいのに、</span><span class="nw">なんだか新しい。</span>
      </h2>
      <p>
        レトロなグラス、赤いさくらんぼ、ゆったりと流れる午後。ソーダ日和は、昔ながらの喫茶店のおいしさと、ときめきを詰め込んだ場所です。ひとりでも、友だちとでも、思い思いの時間をお楽しみください。
      </p>
      <p class="about__owner"><b>店主のこと（架空設定）</b>{ownerStory}</p>
      <dl class="facts">
        {facts.map((f) => <div><dt class="facts__n">{f.n}</dt><dd class="facts__l">{f.l}</dd></div>)}
      </dl>
    </div>
  </div>
</section>
