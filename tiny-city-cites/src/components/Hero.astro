---
import { site } from '../config/site';
const cta = site.contact.instagramUrl || '#contact';
const external = Boolean(site.contact.instagramUrl);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container">
    <h1 id="hero-title">
      <span class="nowrap">小さなお店に、</span><span class="nowrap">ちょうどいいWebを。</span>
    </h1>
    <p class="hero__lead">
      飲食店や個人商店のホームページを作っています。会津大学の学生が勉強しながら取り組んでいるので、料金は抑えめです。
    </p>
    <p class="hero__actions">
      <a
        class="btn"
        href={cta}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}>Instagramで相談する</a
      >
      <a class="textlink" href="#works">制作事例を見る</a>
    </p>
  </div>
</section>
