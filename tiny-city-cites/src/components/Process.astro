---
const steps = [
  { title: 'ご相談', desc: 'お店の状況や、載せたい情報、ご希望を伺います。' },
  { title: '構成・デザイン', desc: '必要な情報を整理して、デザインをご提案します。' },
  { title: '制作・確認', desc: '内容をご確認いただきながら、調整して仕上げます。' },
  { title: '公開・運用', desc: '最終確認後に公開します。更新や保守もご相談ください。' },
];
---

<section class="section" id="flow" aria-labelledby="flow-title">
  <div class="container">
    <h2 id="flow-title">ご依頼の流れ</h2>
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
