---
import { site } from '../config/site';
const { operator, location } = site;
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about">
    <div>
      <h2 id="about-title">運営者について</h2>
      <p>{operator.bio}</p>
      <dl class="facts">
        <div><dt>出身</dt><dd>静岡県</dd></div>
        <div><dt>所属</dt><dd>会津大学 学部4年(ソフトウェア専攻)</dd></div>
        <div><dt>趣味</dt><dd>登山</dd></div>
        <div><dt>拠点</dt><dd>{location.current}</dd></div>
      </dl>
    </div>
    <img
      src="/images/20251122_140921.webp"
      alt="黄色く色づいた銀杏の大木と、茅葺き屋根の建物"
      width="1972"
      height="1695"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="container hiking">
    <figure>
      <img src="/images/mountain-lake.webp" alt="雲海の上に広がる青空と、山あいの青い湖" width="1800" height="1305" loading="lazy" decoding="async" />
    </figure>
    <figure>
      <img src="/images/mountain-trail.webp" alt="雲海を見下ろす、岩の多い山の登山道" width="1800" height="1350" loading="lazy" decoding="async" />
    </figure>
  </div>
</section>
