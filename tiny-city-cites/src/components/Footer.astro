---
import { site } from '../config/site';
const { instagramUrl } = site.contact;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <p class="footer__brand">{site.name}</p>
        <p class="footer__tag">{site.tagline}</p>
      </div>
      <nav class="footer__links" aria-label="フッター">
        {
          instagramUrl && (
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
          )
        }
        {site.privacyUrl && <a href={site.privacyUrl}>Privacy</a>}
        <a href="#top">ページ上部へ ↑</a>
      </nav>
    </div>
    <p class="footer__copy">Copyright © {site.name}</p>
  </div>
</footer>
