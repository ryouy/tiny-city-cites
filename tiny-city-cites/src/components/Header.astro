---
import { site } from '../config/site';

const links = [
  ...(site.works.show ? [{ href: '#works', ja: '制作事例' }] : []),
  { href: '#services', ja: 'サービス' },
  { href: '#flow', ja: 'ご依頼の流れ' },
  { href: '#about', ja: '運営者について' },
  { href: '#contact', ja: 'お問い合わせ' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="#top" aria-label={`${site.name} ページ上部へ`}>{site.name}</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle-label">メニュー</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="メインナビゲーション">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.ja}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
