---
import Photo from './Photo.astro';
import { custom, preferences } from '../data/site';
---

<section class="custom" id="custom" aria-labelledby="custom-title">
  <div class="container custom__grid">
    <Photo name="noodle" ratio="2 / 1" ratioWide="4 / 5" sizes="(min-width: 800px) 40vw, 100vw" pos="50% 40%" class="custom__photo" />
    <div>
    <h2 id="custom-title" class="h2">{custom.heading}</h2>
    <p class="custom__lead">{custom.body}</p>

    <form class="sim" data-sim aria-label="お好みシミュレーター" onsubmit="return false">
      {
        preferences.map((p) => (
          <fieldset class="sim__group">
            <legend>{p.label}</legend>
            <div class="sim__opts">
              {p.options.map((o) => (
                <label class="sim__opt">
                  <input type="radio" name={p.id} value={o} checked={o === 'ふつう'} />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
      <p class="sim__say" data-say tabindex="-1" aria-live="polite">麺ふつう、味ふつう、油ふつうでお願いします。</p>
      <div class="sim__actions">
        <button class="btn btn--ink" type="button" data-copy>伝え方をコピー</button>
        <button class="btn btn--line" type="button" data-reset>すべて「ふつう」に戻す</button>
      </div>
      <p class="sim__status" data-status role="status"></p>
      <p class="sim__note">{custom.note}{custom.disclaimer}</p>
    </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-sim]');
  if (form) {
    const say = form.querySelector<HTMLElement>('[data-say]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const groups = [
      { name: 'noodle', short: '麺' },
      { name: 'taste', short: '味' },
      { name: 'oil', short: '油' },
    ];
    const val = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? 'ふつう';
    const sentence = () => `${groups.map((g) => `${g.short}${val(g.name)}`).join('、')}でお願いします。`;
    const update = () => {
      say.textContent = sentence();
      status.textContent = '';
    };
    form.addEventListener('change', update);
    form.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => (r.checked = r.value === 'ふつう'));
      update();
    });
    form.querySelector('[data-copy]')?.addEventListener('click', async () => {
      const text = sentence();
      try {
        await navigator.clipboard.writeText(text);
        status.textContent = 'コピーしました。';
      } catch {
        // Clipboard API が使えない場合は文章を選択状態にして手動コピーを案内
        const range = document.createRange();
        range.selectNodeContents(say);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        status.textContent = 'コピーできませんでした。選択された文章をそのままコピーしてください。';
      }
    });
  }
</script>
