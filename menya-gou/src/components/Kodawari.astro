---
import Photo from './Photo.astro';
import { about, kodawari, owner } from '../data/site';
import { phrases } from '../lib/phrases';
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__text reveal">
      <p class="eyebrow"><span>01</span>ABOUT</p>
      <h2 id="about-title" class="h2" set:html={phrases(about.heading)} />
      <p class="lead">{about.body}</p>
      <div class="owner">
        <h3 class="owner__title">{owner.heading}<small>{owner.note}</small></h3>
        <p>{owner.body}</p>
      </div>
    </div>
    <div class="about__photo reveal">
      <Photo name="noodle" ratio="4 / 5" sizes="(min-width: 900px) 40vw, 100vw" />
    </div>
  </div>
</section>

<section class="kodawari" id="kodawari" aria-labelledby="kodawari-title">
  <div class="container">
    <div class="kodawari__head reveal">
      <p class="eyebrow eyebrow--dark"><span>02</span>KODAWARI</p>
      <h2 id="kodawari-title" class="h2 h2--dark">こだわり<span class="h2__sub">スープ・麺・鶏油</span></h2>
    </div>
    <div class="kodawari__photo reveal">
      <Photo name="soup" ratio="4 / 3" ratioWide="21 / 9" sizes="(min-width: 1200px) 1120px, 100vw" />
    </div>
    <ol class="kodawari__list">
      {
        kodawari.map((k) => (
          <li class="kodawari__item reveal">
            <span class="kodawari__no" aria-hidden="true">{k.no}</span>
            <p class="kodawari__en" aria-hidden="true">{k.en}</p>
            <h3 class="kodawari__title">{k.title}</h3>
            <p>{k.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
