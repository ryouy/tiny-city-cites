---
import { menu, yen } from '../data/menu';
---

<section class="menu" id="menu" aria-labelledby="menu-title">
  <div class="container">
    <div class="menu__head reveal">
      <p class="eyebrow"><span>03</span>MENU</p>
      <h2 id="menu-title" class="h2">お品書き<span class="h2__sub">価格はすべて税込</span></h2>
    </div>

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="お品書きのカテゴリ">
        {
          menu.map((c, i) => (
            <button
              class="tabs__tab"
              type="button"
              role="tab"
              id={`tab-${c.id}`}
              aria-controls={`panel-${c.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {c.tab}
            </button>
          ))
        }
      </div>

      {
        menu.map((c, i) => (
          <div class="tabs__panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`cat-${c.id}`} data-open={i === 0 ? 'true' : 'false'}>
            <h3 class="cat__title" id={`cat-${c.id}`}>
              {c.title}
              <small>税込</small>
            </h3>
            <ul class={`dishes dishes--${c.id}`}>
              {c.items.map((i) => (
                <li class="dish">
                  <div class="dish__head">
                    <h4 class="dish__name">
                      {i.name}
                      {i.label && <span class="dish__tag">{i.label}</span>}
                    </h4>
                    <span class="dish__price" aria-label={`${yen(i.price)}(税込)`}>
                      <b aria-hidden="true">{i.price.toLocaleString('en-US')}</b><small aria-hidden="true">円</small>
                    </span>
                  </div>
                  {i.description && <p class="dish__desc">{i.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="menu__foot">お好み選択（麺の硬さ・味の濃さ・油の量）は追加料金なし。注文は入店時に券売機で食券を購入します。</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (idx: number, focus = false) => {
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === idx));
        t.tabIndex = i === idx ? 0 : -1;
      });
      panels.forEach((p, i) => p.setAttribute('data-open', String(i === idx)));
      if (focus) tabs[idx].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % n;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + n) % n;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = n - 1;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });
  });
</script>
