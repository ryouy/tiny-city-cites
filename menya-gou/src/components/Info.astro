---
import Photo from './Photo.astro';
import MapEmbed from './MapEmbed.astro';
import { about, rice, info } from '../data/site';
---

<section class="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <Photo name="rice" ratio="16 / 9" ratioWide="4 / 3" sizes="(min-width: 800px) 40vw, 100vw" pos="40% 50%" />
    <div>
      <h2 id="about-title" class="h2">{about.heading}</h2>
      <p>{about.body}</p>
      <h3 class="about__sub">{rice.heading}</h3>
      <p>{rice.body}</p>
    </div>
  </div>
</section>

<section class="info" id="information" aria-labelledby="info-title">
  <div class="container">
    <h2 id="info-title" class="h2">{info.heading}</h2>
    <p class="info__lead">{info.body}</p>
    <div class="info__grid">
      <div>
        <dl class="spec">
          {
            info.rows.map((r) => (
              <div class="spec__row">
                <dt>{r.dt}</dt>
                <dd>{r.dd}</dd>
              </div>
            ))
          }
        </dl>
        <p class="info__area">{info.area}</p>
      </div>
      <div>
        <MapEmbed />
      </div>
    </div>
  </div>
</section>
