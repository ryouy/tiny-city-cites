---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SectionNav from '../components/SectionNav.astro';
import Photo from '../components/Photo.astro';
import MapEmbed from '../components/MapEmbed.astro';
import MenuTabs from '../components/MenuTabs.astro';
import ReservationDialog from '../components/ReservationDialog.astro';
import { site } from '../data/site';
import { courses, courseNote } from '../data/course';
import { yen } from '../data/menu';

const seatsTotal = site.space.seats.reduce((s, x) => s + x.count, 0);
const [h1a, h1b] = site.hero.h1.split('と地酒');
const heroFacts = [
  { term: '営業時間', desc: '17:30–23:00' },
  { term: '定休日', desc: '毎週日曜日' },
  { term: '席数', desc: `${seatsTotal}席` },
];
---

<BaseLayout>
  <Header />
  <SectionNav />
  <main id="main">
    <!-- Hero -->
    <section class="hero" id="top" aria-labelledby="hero-title">
      <Photo name="hero" fill eager pos="70% 60%" sizes="100vw" />
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="wrap hero__inner">
        <h1 class="hero__title" id="hero-title">
          <span class="nw">{h1a}と</span><span class="nw">地酒{h1b}</span>
        </h1>
        <p class="hero__body">{site.hero.body}</p>
        <div class="hero__cta">
          <a class="btn btn--solid" href={site.hero.ctas[0].href}>{site.hero.ctas[0].label}</a>
          <a class="btn btn--ghost" href={site.hero.ctas[1].href}>{site.hero.ctas[1].label}</a>
        </div>
      </div>
      <dl class="hero__facts">
        {
          heroFacts.map((f) => (
            <div>
              <dt>{f.term}</dt>
              <dd>{f.desc}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 灯について: 左に文章、右は画面端まで写真 -->
    <section class="screen screen--alt about" id="about" aria-labelledby="about-title">
      <div class="about__text">
        <div class="about__text-inner reveal">
          <h2 class="h2" id="about-title">{site.about.heading}</h2>
          <p class="lead">{site.about.body}</p>
          <p class="owner">{site.about.owner}</p>
        </div>
      </div>
      <div class="about__photo">
        <Photo name="yakitori" fill pos="50% 58%" sizes="(min-width: 900px) 45vw, 100vw" />
        <p class="about__vertical" aria-hidden="true">{site.name}</p>
      </div>
    </section>

    <!-- お品書き: 画面内のタブで切り替え -->
    <section class="screen menu paper" id="menu" aria-labelledby="menu-title">
      <div class="wrap">
        <MenuTabs>
          <Fragment slot="head">
            <h2 class="h2" id="menu-title">お品書き</h2>
            <p class="note">{site.priceNote}</p>
          </Fragment>
        </MenuTabs>
      </div>
    </section>

    <!-- 地酒: 左に写真 -->
    <section class="screen sake" id="sake" aria-labelledby="sake-title">
      <div class="sake__photo">
        <Photo name="sake" fill pos="40% 60%" sizes="(min-width: 900px) 55vw, 100vw" />
      </div>
      <div class="sake__text">
        <div class="sake__text-inner reveal">
          <h2 class="h2" id="sake-title">{site.sake.heading}</h2>
          <p class="lead">{site.sake.body}</p>
          <p class="fine">{site.sake.note}</p>
        </div>
      </div>
    </section>

    <!-- コース: 写真なし、文字だけで見せる -->
    <section class="screen course" id="course" aria-labelledby="course-title">
      <div class="wrap">
        <header class="course__head">
          <h2 class="h2" id="course-title">コース</h2>
          <p class="note">{courseNote}</p>
        </header>
        <div class="courses">
          {
            courses.map((c) => (
              <article class="course-item reveal" aria-labelledby={`course-${c.id}`}>
                <h3 class="course-item__name" id={`course-${c.id}`}>{c.name}</h3>
                <p class="course-item__price">
                  <span class="sr-only">税込 </span>
                  <span class="course-item__num">{yen(c.price)}</span>
                  <span class="course-item__unit">／1名（税込）</span>
                </p>
                <ul class="course-item__list">
                  {c.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
                <p class="course-item__cond">{c.condition}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- お席: 写真2枚+席数 -->
    <section class="screen space" id="space" aria-labelledby="space-title">
      <div class="space__top">
        <div class="space__counter">
          <Photo name="counter" fill pos="50% 50%" sizes="100vw" />
          <div class="space__shade" aria-hidden="true"></div>
        </div>
        <div class="seats wrap">
          <p class="seats__total">
            <span class="seats__num">{seatsTotal}</span><span class="seats__unit">席</span>
            <span class="sr-only">（内訳は以下）</span>
          </p>
          <ul class="seats__list">
            {
              site.space.seats.map((s) => (
                <li>
                  <span class="seats__name">{s.name}</span>
                  <span class="seats__count">{s.count}席</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="wrap space__body">
        <div class="space__text reveal">
          <h2 class="h2" id="space-title">{site.space.heading}</h2>
          <p class="lead">{site.space.body}</p>
        </div>
        <div class="space__semi">
          <Photo name="semiPrivate" fill pos="50% 50%" sizes="(min-width: 900px) 34vw, 100vw" />
        </div>
      </div>
    </section>

    <!-- ご予約案内 -->
    <section class="screen reservation" id="reservation" aria-labelledby="reservation-title">
      <div class="wrap reservation__grid">
        <div class="reservation__intro">
          <h2 class="h2" id="reservation-title">{site.reservation.heading}</h2>
          <p class="lead">{site.reservation.lead}</p>
          <button class="btn btn--solid" type="button" data-open-demo aria-haspopup="dialog">
            {site.reservation.demoButton}
          </button>
          <p class="notice">{site.reservation.demoNotice}</p>
        </div>
        <div class="reservation__body">
          <dl class="facts">
            {
              site.reservation.facts.map((f) => (
                <div>
                  <dt>{f.term}</dt>
                  <dd>{f.desc}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- 営業情報 -->
    <section class="screen info" id="info" aria-labelledby="info-title">
      <div class="wrap info__grid">
        <div class="info__main">
          <h2 class="h2" id="info-title">営業情報</h2>
          <dl class="spec">
            {
              site.info.map((row) => (
                <div>
                  <dt>{row.term}</dt>
                  <dd>{row.desc}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="info__side">
          <div class="info__photo">
            <Photo name="exterior" fill pos="55% 45%" sizes="(min-width: 900px) 40vw, 100vw" />
          </div>
          <MapEmbed />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer__grid">
      <p class="footer__name">{site.name}</p>
      <nav aria-label="フッターメニュー">
        <ul class="footer__nav">
          {
            site.nav.map((n) => (
              <li>
                <a href={n.href}>{n.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="wrap">
      <p class="footer__disclaimer">{site.disclaimer}</p>
    </div>
  </footer>

  <ReservationDialog />
</BaseLayout>
