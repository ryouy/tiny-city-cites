---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { imageDir, imageExts, photos, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  /** CSS aspect-ratio 形式 例: "4 / 5"。fill のときは不要 */
  ratio?: string;
  eager?: boolean;
  /** true なら親要素いっぱいに広げる(親に高さを持たせる) */
  fill?: boolean;
  /** object-position 例: "60% 40%" */
  pos?: string;
  sizes?: string;
  class?: string;
}
const { name, ratio, eager = false, fill = false, pos = '50% 50%', sizes = '100vw', class: className = '' } = Astro.props;
const photo = photos[name];

// ビルド時に拡張子(webp / avif / jpg / png ...)を自動判定する。無ければ「画像準備中」の面を出す
const file = imageExts.map((e) => `${photo.base}.${e}`).find((f) => existsSync(join(process.cwd(), 'public', imageDir, f)));
const style = `--pos:${pos};${ratio ? `aspect-ratio:${ratio};` : ''}`;
const cls = ['photo', fill ? 'photo--fill' : '', className].filter(Boolean).join(' ');
---

{
  file ? (
    <div class={cls} style={style}>
      <img
        src={`${import.meta.env.BASE_URL}${imageDir.slice(1)}${file}`}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding={eager ? 'sync' : 'async'}
      />
    </div>
  ) : (
    <div class={`${cls} photo--placeholder`} style={style} role="img" aria-label={`画像準備中：${photo.alt}`}>
      <span class="photo__status" aria-hidden="true">画像準備中</span>
    </div>
  )
}
