---
import { reservationDemo as r } from '../data/reservation';
import { courses } from '../data/course';
---

<dialog
  class="demo-dialog"
  id="demo-dialog"
  aria-labelledby="demo-dialog-title"
  aria-describedby="demo-dialog-banner"
  data-config={JSON.stringify({
    tz: r.timezone,
    closed: r.closedWeekday,
    closedLabel: r.closedLabel,
    courseMinParty: r.courseMinParty,
    courseLeadDays: r.courseLeadDays,
    options: r.options,
  })}
>
  <div class="dlg">
    <div class="dlg__head">
      <p class="dlg__eyebrow" lang="en">Reservation Preview</p>
      <h2 class="dlg__title" id="demo-dialog-title" tabindex="-1">予約画面のデモ</h2>
      <button class="dlg__x" type="button" data-close aria-label="閉じる">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <p class="dlg__banner" id="demo-dialog-banner">{r.banner}</p>

    <form class="dlg__form" novalidate data-form>
      <div class="dlg__errors" role="alert" data-errors hidden></div>

      <div class="field">
        <label for="demo-date">来店希望日</label>
        <input id="demo-date" name="date" type="date" required aria-describedby="demo-date-hint" />
        <p class="field__hint" id="demo-date-hint">
          {r.closedLabel}（定休日）と過去の日付は選べません。空席状況の確認は行いません。
        </p>
      </div>

      <fieldset class="field">
        <legend>時間帯</legend>
        <div class="choices choices--row">
          {
            r.times.map((t) => (
              <label class="choice">
                <input type="radio" name="time" value={t} />
                <span>{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field">
        <label for="demo-party">人数</label>
        <select id="demo-party" name="party">
          {
            Array.from({ length: r.partyMax - r.partyMin + 1 }, (_, i) => r.partyMin + i).map((n) => (
              <option value={n} selected={n === 2}>
                {n}名
              </option>
            ))
          }
        </select>
      </div>

      <fieldset class="field">
        <legend>コース選択</legend>
        <div class="choices">
          {
            r.options.map((o, i) => (
              <label class="choice choice--wide">
                <input type="radio" name="course" value={o.id} checked={i === 0} />
                <span>
                  {o.label}
                  {o.course && (
                    <small>
                      {' '}
                      {courses.find((c) => c.id === o.id)?.price.toLocaleString('en-US')}円／1名・2名から
                    </small>
                  )}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="dlg__actions">
        <button class="btn btn--solid" type="submit">内容を確認</button>
        <button class="btn btn--ghost" type="button" data-close>閉じる</button>
      </div>
    </form>

    <div class="dlg__confirm" data-confirm hidden>
      <h3 class="dlg__sub" tabindex="-1" data-confirm-title>入力内容の確認（デモ）</h3>
      <dl class="summary" data-summary></dl>
      <p class="dlg__fine">この内容は保存・送信されません。空席の確認や予約の確定も行っていません。</p>
      <div class="dlg__actions">
        <button class="btn btn--ghost" type="button" data-back>入力内容を修正</button>
        <button class="btn btn--solid" type="button" data-close>閉じる</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('demo-dialog') as HTMLDialogElement | null;
  if (dialog) {
    const cfg = JSON.parse(dialog.dataset.config ?? '{}') as {
      tz: string;
      closed: number;
      closedLabel: string;
      courseMinParty: number;
      courseLeadDays: number;
      options: { id: string; label: string; course: boolean }[];
    };
    const form = dialog.querySelector<HTMLFormElement>('[data-form]')!;
    const confirmEl = dialog.querySelector<HTMLElement>('[data-confirm]')!;
    const summary = dialog.querySelector<HTMLElement>('[data-summary]')!;
    const errorsEl = dialog.querySelector<HTMLElement>('[data-errors]')!;
    const dateInput = form.elements.namedItem('date') as HTMLInputElement;
    let opener: HTMLElement | null = null;

    // Asia/Tokyo 基準の「今日」(端末のタイムゾーンに依存しない)
    const todayJst = () =>
      new Intl.DateTimeFormat('en-CA', {
        timeZone: cfg.tz,
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date());
    const toUtc = (s: string) => {
      const [y, m, d] = s.split('-').map(Number);
      return Date.UTC(y, m - 1, d);
    };
    const weekday = ['日', '月', '火', '水', '木', '金', '土'];
    const fmtDate = (s: string) => {
      const t = new Date(toUtc(s));
      return `${t.getUTCFullYear()}年${t.getUTCMonth() + 1}月${t.getUTCDate()}日（${weekday[t.getUTCDay()]}）`;
    };

    const showErrors = (list: { msg: string; field?: HTMLElement }[]) => {
      errorsEl.replaceChildren();
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      if (!list.length) {
        errorsEl.hidden = true;
        return;
      }
      const ul = document.createElement('ul');
      list.forEach((e) => {
        const li = document.createElement('li');
        li.textContent = e.msg;
        ul.append(li);
        e.field?.setAttribute('aria-invalid', 'true');
      });
      errorsEl.append(ul);
      errorsEl.hidden = false;
    };

    const validateDate = (): string | null => {
      const v = dateInput.value;
      if (!v) return '来店希望日を選択してください。';
      const today = todayJst();
      if (toUtc(v) < toUtc(today)) return '過去の日付は選択できません。';
      if (new Date(toUtc(v)).getUTCDay() === cfg.closed)
        return `${cfg.closedLabel}は定休日のため選択できません。`;
      return null;
    };

    // 日曜・過去日を入力された時点で取り消す
    dateInput.addEventListener('change', () => {
      const msg = dateInput.value ? validateDate() : null;
      if (msg) {
        dateInput.value = '';
        showErrors([{ msg, field: dateInput }]);
      } else if (!errorsEl.hidden) {
        showErrors([]);
      }
    });

    const setStep = (step: 'form' | 'confirm') => {
      form.hidden = step !== 'form';
      confirmEl.hidden = step !== 'confirm';
      const target =
        step === 'form'
          ? dialog.querySelector<HTMLElement>('#demo-dialog-title')
          : confirmEl.querySelector<HTMLElement>('[data-confirm-title]');
      target?.focus();
      dialog.scrollTop = 0;
    };

    const open = (from: HTMLElement) => {
      opener = from;
      const t = todayJst();
      dateInput.min = t;
      showErrors([]);
      setStep('form');
      dialog.showModal();
      document.documentElement.classList.add('menu-lock');
      dialog.querySelector<HTMLElement>('#demo-dialog-title')?.focus();
    };
    const close = () => {
      if (dialog.open) dialog.close();
    };
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-lock');
      opener?.focus();
    });

    document.querySelectorAll<HTMLElement>('[data-open-demo]').forEach((b) =>
      b.addEventListener('click', () => open(b)),
    );
    dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', close));
    // 背景クリックで閉じる
    dialog.addEventListener('mousedown', (e) => {
      if (e.target === dialog) close();
    });
    dialog.querySelector('[data-back]')?.addEventListener('click', () => setStep('form'));

    // フォーカストラップ
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        dialog.querySelectorAll<HTMLElement>(
          'button, [href], input:not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || active === dialog || active?.id === 'demo-dialog-title')) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const time = data.get('time') as string | null;
      const party = Number(data.get('party'));
      const courseId = String(data.get('course'));
      const opt = cfg.options.find((o) => o.id === courseId);
      const errs: { msg: string; field?: HTMLElement }[] = [];

      const dateMsg = validateDate();
      if (dateMsg) errs.push({ msg: dateMsg, field: dateInput });
      if (!time) errs.push({ msg: '時間帯を選択してください。' });
      if (opt?.course && party < cfg.courseMinParty)
        errs.push({
          msg: `コースは${cfg.courseMinParty}名からのご案内です。人数を${cfg.courseMinParty}名以上にするか、「席のみ」を選んでください。`,
          field: form.elements.namedItem('party') as HTMLElement,
        });
      if (opt?.course && !dateMsg) {
        const diff = (toUtc(dateInput.value) - toUtc(todayJst())) / 86400000;
        if (diff < cfg.courseLeadDays)
          errs.push({
            msg: `コースは${cfg.courseLeadDays}日前までのご予約を想定しています。日付を変更するか、「席のみ」を選んでください。`,
            field: dateInput,
          });
      }
      showErrors(errs);
      if (errs.length) {
        errorsEl.scrollIntoView({ block: 'nearest' });
        (errs[0].field ?? form.querySelector<HTMLElement>('input[name="time"]'))?.focus();
        return;
      }

      const rows: [string, string][] = [
        ['来店希望日', fmtDate(dateInput.value)],
        ['時間帯', time ?? ''],
        ['人数', `${party}名`],
        ['コース', opt?.label ?? ''],
      ];
      summary.replaceChildren();
      rows.forEach(([k, v]) => {
        const wrap = document.createElement('div');
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = k;
        dd.textContent = v;
        wrap.append(dt, dd);
        summary.append(wrap);
      });
      setStep('confirm');
    });
  }
</script>
